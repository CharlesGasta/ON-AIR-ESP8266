  document.getElementById('idleControls').style.opacity=off?'.38':'1';
}

function updateAnimationHelp(){
  const v=parseInt(document.getElementById('alertAnimation').value||'0',10);
  const e=document.getElementById('animationHelp');

  const txt=[
    'DIRECT / HORS DIRECT a vitesse constante.',
    'Boucle : 100 % instantane → fade jusqu a 0 % → retour instantane a 100 %.',
    'Un seul passage sur toute la duree : vert → jaune → rouge.',
    'DIRECT / HORS DIRECT accelere progressivement sur toute la duree.',
    'Deux flashs courts suivis d une pause, repetes pendant la duree.'
  ];

  e.textContent=txt[v]||txt[0];
}

async function testAlert(){
  await saveNow();

  const r=await fetch('/api/alertTest?i='+macroIndex,{
    cache:'no-store'
  });

  // Le test se termine automatiquement TOUT ETEINT.
  // Aucun retour au menu principal n'est necessaire.
  return r;
}

async function deleteLogo(){
  if(!confirm('Remettre le logo d origine ?'))return;

  await fetch('/deleteLogo?i='+macroIndex,{
    method:'POST'
  });

  location.reload();
}

updateIdleControls();
updateAnimationHelp();

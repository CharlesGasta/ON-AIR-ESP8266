int findKnownWiFi(const String& ssid) {
  for (uint8_t i = 0; i < config.knownWiFiCount && i < MAX_KNOWN_WIFI; i++) {
    if (ssid == String(config.knownWiFi[i].ssid)) return i;
  }
  return -1;
}

bool isKnownWiFi(const String& ssid) {
  return findKnownWiFi(ssid) >= 0;
}

void rememberWiFi(const String& ssid, const String& password) {
  if (!ssid.length()) return;

  int existing = findKnownWiFi(ssid);
  KnownWiFi entry;
  memset(&entry, 0, sizeof(entry));

  if (existing >= 0) {
    entry = config.knownWiFi[existing];

    // Mot de passe vide = conserver celui deja memorise.
    if (password.length() > 0) {
      password.toCharArray(entry.password, sizeof(entry.password));
    }

    // Le reseau utilise le plus recemment repasse en tete.
    for (int i = existing; i > 0; i--) {
      config.knownWiFi[i] = config.knownWiFi[i - 1];
    }
    config.knownWiFi[0] = entry;
  } else {
    strlcpy(entry.ssid, ssid.c_str(), sizeof(entry.ssid));
    password.toCharArray(entry.password, sizeof(entry.password));

    int last = min((int)config.knownWiFiCount, (int)MAX_KNOWN_WIFI - 1);

    for (int i = last; i > 0; i--) {
      config.knownWiFi[i] = config.knownWiFi[i - 1];
    }

    config.knownWiFi[0] = entry;

    if (config.knownWiFiCount < MAX_KNOWN_WIFI) {
      config.knownWiFiCount++;
    }
  }

  Serial.println("[WIFI MEM] Memorise : " + ssid);
}

void forgetKnownWiFi(uint8_t index) {
  if (index >= config.knownWiFiCount || index >= MAX_KNOWN_WIFI) return;

  String removed = config.knownWiFi[index].ssid;

  for (uint8_t i = index; i + 1 < config.knownWiFiCount; i++) {
    config.knownWiFi[i] = config.knownWiFi[i + 1];
  }

  if (config.knownWiFiCount > 0) {
    config.knownWiFiCount--;
  }

  memset(&config.knownWiFi[config.knownWiFiCount], 0, sizeof(KnownWiFi));

  Serial.println("[WIFI MEM] Oublie : " + removed);
}


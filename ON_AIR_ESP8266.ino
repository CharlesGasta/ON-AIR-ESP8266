const uint8_t LED_DATA_PIN = D5;       // GPIO14
const uint16_t LED_COUNT = 36;

Adafruit_NeoPixel pixels(
  LED_COUNT,
  LED_DATA_PIN,
  NEO_GRB + NEO_KHZ800
);


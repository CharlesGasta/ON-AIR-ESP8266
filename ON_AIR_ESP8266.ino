void handleLogo() {
  int i = server.arg("i").toInt();

  if (i < 0 || i >= MACRO_COUNT) {
    server.send_P(404,PSTR("text/plain"),PSTR("Logo absent"));
    return;
  }

  String path = config.macro[i].logoPath;

  if (isBuiltinLogo(path)) {
    switch (i) {
      case 0:
        server.send_P(200, PSTR("image/jpeg"), (PGM_P)LOGO_ONE_FM, LOGO_ONE_FM_LEN);
        return;
      case 1:
        server.send_P(200, PSTR("image/jpeg"), (PGM_P)LOGO_RADIO_LAC, LOGO_RADIO_LAC_LEN);
        return;
      case 2:
        server.send_P(200, PSTR("image/jpeg"), (PGM_P)LOGO_LFM, LOGO_LFM_LEN);
        return;
      case 3:
        server.send_P(200, PSTR("image/jpeg"), (PGM_P)LOGO_ROUGE, LOGO_ROUGE_LEN);
        return;
    }
  }

  if (!path.length() || !LittleFS.exists(path)) {
    server.send_P(404,PSTR("text/plain"),PSTR("Logo absent"));
    return;
  }

  File f = LittleFS.open(path,"r");
  server.streamFile(f,mimeTypeForPath(path));
  f.close();
}


void applyPendingExternalWiFi() {
  if (!pendingExternalWiFiApply) return;

  if ((long)(millis() - pendingExternalWiFiApplyAt) < 0) {
    return;
  }

  pendingExternalWiFiApply = false;

  if (!config.externalWiFiEnabled) {
    Serial.println(F("[WIFI EXT] Desactivation a chaud"));

    // Deconnecte uniquement la partie station.
    WiFi.disconnect(false);
    externalConnectStarted = false;
    currentKnownWiFiAttempt = -1;
    mdnsStarted = false;

    // Le point d'acces ON_AIR-MOC reste present.
    if (WiFi.getMode() != WIFI_AP) {
      WiFi.mode(WIFI_AP);
    }

    return;
  }

  if (config.knownWiFiCount == 0) {
    Serial.println(F("[WIFI EXT] Aucun reseau memorise a appliquer"));
    return;
  }

  const char* targetSSID = config.knownWiFi[0].ssid;
  const char* targetPassword = config.knownWiFi[0].password;

  // Si on est deja connecte au reseau demande, ne touche a rien.
  if (WiFi.status() == WL_CONNECTED &&
      WiFi.SSID() == String(targetSSID)) {

    Serial.println(
      "[WIFI EXT] Deja connecte a " +
      String(targetSSID) +
      " | IP=" + WiFi.localIP().toString()
    );

    externalConnectStarted = true;
    lastExternalReconnectAt = millis();

    startMDNSIfPossible();
    return;
  }

  Serial.println(
    "[WIFI EXT] Connexion a chaud vers " +
    String(targetSSID) +
    " (sans reboot)"
  );

  if (WiFi.getMode() != WIFI_AP_STA) {
    WiFi.mode(WIFI_AP_STA);
    delay(20);
  }

  WiFi.hostname(MDNS_HOSTNAME);

  // Coupe/reinitialise uniquement le client STA.
  WiFi.disconnect(false);
  delay(20);

  mdnsStarted = false;

  WiFi.begin(targetSSID, targetPassword);

  externalConnectStarted = true;
  currentKnownWiFiAttempt = 0;
  lastExternalReconnectAt = millis();
}

void startExternalWiFi() {
  if (!config.externalWiFiEnabled) {
    Serial.println(F("[WIFI EXT] Desactive"));
    return;
  }

  if (config.knownWiFiCount == 0) {
    Serial.println(F("[WIFI EXT] Aucun Wi-Fi memorise"));
    return;
  }

  // IMPORTANT POUR IPHONE :
  // Ne pas lancer de scan Wi-Fi synchrone pendant que le telephone effectue
  // sa premiere detection captive. WiFi.begin() rend la main immediatement.
  // Le scan du meilleur reseau reste disponible pour la reconnexion plus tard.
  if (WiFi.getMode() != WIFI_AP_STA) WiFi.mode(WIFI_AP_STA);
  WiFi.hostname(MDNS_HOSTNAME);
  WiFi.begin(config.knownWiFi[0].ssid,config.knownWiFi[0].password);
  currentKnownWiFiAttempt = 0;
  externalConnectStarted = true;
  lastExternalReconnectAt = millis();

  Serial.println("[WIFI EXT] Connexion directe sans scan bloquant : " +
                 String(config.knownWiFi[0].ssid));
}

void startMDNSIfPossible() {
  if (mdnsStarted || WiFi.status() != WL_CONNECTED) return;
  // A failed discovery allocation must not trigger another attempt every loop.
  static unsigned long lastMDNSAttempt=0;
  if(lastMDNSAttempt&&millis()-lastMDNSAttempt<5000UL)return;
  if(ESP.getFreeHeap()<12000||ESP.getMaxFreeBlockSize()<6000)return;
  lastMDNSAttempt=millis();

  setStartupIndicatorState(STARTUP_IND_MDNS);

  if (MDNS.begin(MDNS_HOSTNAME)) {
    MDNS.addService("http", "tcp", 80);
    mdnsStarted = true;

    Serial.println(F("[mDNS] OK"));
    Serial.println("[mDNS] http://" + String(MDNS_HOSTNAME) + ".local");
  } else {
    Serial.println(F("[mDNS] ECHEC"));
  }
}

void updateExternalWiFi() {
  if (!config.externalWiFiEnabled || config.knownWiFiCount == 0) return;

  // Ne lance jamais un second scan pendant une operation manuelle.
  if (wifiScanRunning || wifiScanStartRequested || pendingExternalWiFiApply) return;

  if (WiFi.status() == WL_CONNECTED) {
    startMDNSIfPossible();
    return;
  }

  mdnsStarted = false;

  unsigned long now = millis();

  if (!externalConnectStarted ||
      now - lastExternalReconnectAt >= EXTERNAL_RECONNECT_MS) {

    // Un scan automatique peut faire sauter momentanement un client
    // connecte directement a ON_AIR-MOC. On privilegie donc l'interface :
    // tant qu'un telephone est sur l'AP, aucun scan automatique.
    if (WiFi.softAPgetStationNum() > 0) {
      return;
    }

    externalConnectStarted = true;
    lastExternalReconnectAt = now;

    connectBestKnownWiFi();
  }
}

void setup() {
  otaBootId=ESP.random();
  Serial.begin(115200);
  delay(150);
  Serial.println();
  Serial.println(F("==========================================="));
  Serial.println(F(" CARAC ON AIR MANUAL - ESP8266"));
  Serial.println(" Firmware " + String(FIRMWARE_VERSION));
  Serial.println(F("==========================================="));

  pixels.begin();
  pixels.setBrightness(255);
  pixels.clear();
  pixels.show();

  Serial.println(F("[LED] WS2812E adressable"));
  Serial.println(F("[LED] D5 / GPIO14 | 36 LED | GRB 800 kHz"));
  Serial.println("[LED SAFETY] Limite globale sortie = " + String(LED_GLOBAL_MAX_PERCENT) + "%");

  if (!LittleFS.begin()) Serial.println(F("[FS] ECHEC LittleFS"));
  else Serial.println(F("[FS] LittleFS OK"));

  Serial.printf_P(PSTR("[BOOT] reset=%s | heap=%u | maxblock=%u\n"),ESP.getResetReason().c_str(),ESP.getFreeHeap(),ESP.getMaxFreeBlockSize());
  Serial.println(ESP.getResetInfo());
  loadConfig();
  loadMotionSettings();
  migrateAnimationLibrary();

  // Etat initial propre, puis indicateur de progression sans ralentir le boot.
  blackout();

  // Le Wi-Fi apparait immediatement au demarrage.
  startAccessPoint();
  setupWebServer();

  if (config.externalWiFiEnabled && config.knownWiFiCount > 0) {
    setStartupIndicatorState(STARTUP_IND_WIFI);
  }

  startExternalWiFi();

  if (!config.externalWiFiEnabled || config.knownWiFiCount == 0) {
    setStartupIndicatorState(STARTUP_IND_READY);
  }

  Serial.println("[READY] Wi-Fi autonome : " + String(config.apSSID));
  Serial.println(F("[READY] Acces direct GARANTI : http://192.168.4.1"));
  Serial.println(F("[READY] .local uniquement sur le Wi-Fi externe"));
  if (config.externalWiFiEnabled) {
    Serial.println("[READY] Wi-Fi memorises : " + String(config.knownWiFiCount));
    Serial.println(F("[READY] Acces stable via routeur : http://onair-moc.local"));
  }
  Serial.printf_P(PSTR("[MEMORY] ready heap=%u maxblock=%u stack=%u\n"),ESP.getFreeHeap(),ESP.getMaxFreeBlockSize(),ESP.getFreeContStack());
  // Start the cinematic clock only after blocking hardware/network setup.
  if(config.startupAnimation)startupAnimation();
}

void loop() {
  // Portail captif : traiter les requetes DNS avant le HTTP.
  if(!webMinimumHeap||ESP.getFreeHeap()<webMinimumHeap)webMinimumHeap=ESP.getFreeHeap();
  dnsServer.processNextRequest();

  // Le serveur HTTP est toujours prioritaire.
  server.handleClient();

  serviceFirmwareUpdate();
  if(otaReceiving||otaRestartAt){yield();return;}

  updateLibraryPreview();
  updateAlert();
  updateSettingsPreview();
  updateDirectMotion();
  updateWiFiScan();
  applyPendingExternalWiFi();

  updateStartupIndicatorNetworkState();
  updateExternalWiFi();
  updateStartupIndicator();

  if (mdnsStarted) {
    MDNS.update();
  }

  static unsigned long lastAPDiag = 0;
  if (millis() - lastAPDiag >= 15000UL) {
    lastAPDiag = millis();

    Serial.println(
      "[WIFI AP] Actif | IP=" + WiFi.softAPIP().toString() +
      " | clients=" + String(WiFi.softAPgetStationNum())
    );

    if (config.externalWiFiEnabled) {
      if (WiFi.status() == WL_CONNECTED) {
        Serial.println(
          "[WIFI EXT] CONNECTE | SSID=" + WiFi.SSID() +
          " | IP=" + WiFi.localIP().toString()
        );
      } else {
        Serial.println(F("[WIFI EXT] NON CONNECTE"));
      }
    }
  }

  yield();
}

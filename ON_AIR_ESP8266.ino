String statusJSON() {
  String j;
  j.reserve(260);

  j = "{";

  j += "\"output_enabled\":";
  j += outputEnabled ? "true" : "false";

  j += ",\"alert_running\":";
  j += alertRunning ? "true" : "false";

  j += ",\"alert_visible\":";
  j += alertVisible ? "true" : "false";

  j += ",\"alert_macro\":";
  j += String(alertMacro);

  j += ",\"led_hex\":\"";
  j += rgbToHex(currentLedR,currentLedG,currentLedB);
  j += "\"";

  j += ",\"led_intensity\":";
  j += String(currentLedIntensity);

  j += ",\"active_macro\":";
  j += String(activeMacro);

  j += ",\"active_name\":\"";
  if (activeMacro >= 0 && activeMacro < MACRO_COUNT) {
    j += jsonEscape(String(config.macro[activeMacro].name));
  }
  j += "\"";

  j += "}";

  return j;
}

bool parseMacroIndex(uint8_t& i) {
  if (!server.hasArg("i")) return false;
  int v = server.arg("i").toInt();
  if (v < 0 || v >= MACRO_COUNT) return false;
  i = (uint8_t)v;
  return true;
}


void redirectHome() {
  server.sendHeader("Location", "/", true);
  server.send(302, "text/plain", "");
}

void sendStatusResponse() {
  server.sendHeader("Cache-Control","no-store");
  server.sendHeader("Connection","close");
  server.send(200,"application/json",statusJSON());
}

void handleDirect() {
  uint8_t i;

  if (!parseMacroIndex(i)) {
    server.send(400,"application/json","{\"error\":\"macro invalide\"}");
    return;
  }

  // Ne permet aucune commande DIRECT pendant une alerte.
  if (alertRunning) {
    server.sendHeader("Connection","close");
    sendStatusResponse();
    return;
  }

  // Appui sur le DIRECT deja actif = retour HORS DIRECT.
  if (outputEnabled && activeMacro == i) {
    applyMacroIdle(i);
    sendStatusResponse();
    return;
  }

  // Une autre macro est deja active : verrouillage.
  if (outputEnabled && activeMacro >= 0 && activeMacro != i) {
    Serial.println("[MACRO] DIRECT refuse : une autre macro est active");
    sendStatusResponse();
    return;
  }

  applyMacro(i);
  sendStatusResponse();
}

void handleAlert() {
  uint8_t i;

  if (!parseMacroIndex(i)) {
    server.send(400,"application/json","{\"error\":\"macro invalide\"}");
    return;
  }

  // Une alerte ne peut etre lancee que lorsque le ON AIR est eteint.
  if (alertRunning || outputEnabled) {
    Serial.println("[MACRO] ALERTE refusee : sortie deja active");
    sendStatusResponse();
    return;
  }

  startAlert(i);
  sendStatusResponse();
}

void handleAlertTest() {
  uint8_t i;

  if (!parseMacroIndex(i)) {
    server.send(400,"application/json","{\"error\":\"macro invalide\"}");
    return;
  }

  // On refuse seulement si un vrai DIRECT est actuellement actif.
  // Apres un test, le boitier revient automatiquement TOUT ETEINT.
  if (alertRunning || outputEnabled) {
    Serial.println("[MACRO] TEST ALERTE refuse : sortie deja active");
    sendStatusResponse();
    return;
  }

  startAlert(i, true);
  sendStatusResponse();
}

void handleOff() {
  // OFF est volontairement prioritaire :
  // il annule DIRECT, HORS DIRECT ou ALERTE et met physiquement le RGB a noir.
  blackout();

  Serial.println("[ON AIR] OFF depuis interface");

  sendStatusResponse();
}



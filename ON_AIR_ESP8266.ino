      if (now - alertLastToggleAt >= m.blinkMs) {
        alertLastToggleAt = now;
        alertVisible = !alertVisible;

        if (alertVisible) renderMacroDirect(alertMacro);
        else renderMacroIdle(alertMacro);
      }
      break;
    }
  }
}

void showMacroPreview(uint8_t i, bool directState) {
  if(libraryPreviewActive)strncpy(libraryPreviewRevokedToken,libraryPreviewToken,40);
  libraryPreviewActive=false;libraryPreviewToken[0]=0;customOwner=-1;
  customPreview=false;
  if (i >= MACRO_COUNT || alertRunning) return;

  cancelStartupIndicator();
  previewMotionMacro=i;previewMotionDirect=directState;
  directMotionStartedAt=millis();
  settingsPreviewActive = true;
  settingsPreviewUntil = millis() + SETTINGS_PREVIEW_HOLD_MS;

  if (directState) {
    renderMacroDirect(i);
  } else {
    renderMacroIdle(i);
  }
}

void updateSettingsPreview() {
  if (!settingsPreviewActive || alertRunning) return;

  if ((long)(millis() - settingsPreviewUntil) >= 0) {
    settingsPreviewActive = false;
    renderCurrentOutput();
  }
}

void updateDirectMotion() {
  if(libraryPreviewActive)return;
  if(alertRunning||!startupSequenceComplete)return;
  int i=settingsPreviewActive&&previewMotionDirect?previewMotionMacro:outputEnabled&&!settingsPreviewActive?activeMacro:-1;
  if(i<0||i>=MACRO_COUNT||(motionSettings.mode[i]==0&&!(settingsPreviewActive&&customPreview)))return;
  unsigned long now=millis();if(now-liveMotionLastFrameAt<(isLibraryId(motionSettings.mode[i])?cueFrameInterval(customData):33UL))return;
  liveMotionLastFrameAt=now;
  renderMacroDirect(i);
}

void startupAnimation() {
  startupRestoreMacro=startupTestActive?activeMacro:-1;
  settingsPreviewActive=false;activeMacro=-1;outputEnabled=false;
  startupSequenceComplete=false;startupAPFailed=false;
  startupSessionStartedAt=millis();startupIndicatorLastToggle=0;
  enterStartupState(STARTUP_IND_INTRO);
}

String mimeTypeForPath(String path) {
  path.toLowerCase();
  if (path.endsWith(".png")) return "image/png";
  if (path.endsWith(".jpg") || path.endsWith(".jpeg")) return "image/jpeg";
  return "application/octet-stream";
}


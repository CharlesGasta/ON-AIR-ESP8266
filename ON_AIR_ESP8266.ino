void clearWiFiScanResults() {
  wifiScanItemCount = 0;
  memset(wifiScanItems, 0, sizeof(wifiScanItems));
}

void beginWiFiScanAsync() {
  if (wifiScanRunning) return;

  Serial.println(F("[WIFI SCAN] Demarrage asynchrone..."));

  // Le point d'acces reste actif pendant le scan.
  if (WiFi.getMode() == WIFI_AP) {
    WiFi.mode(WIFI_AP_STA);
  }

  clearWiFiScanResults();
  wifiScanReady = false;
  wifiScanFailed = false;
  wifiScanRunning = true;

  WiFi.scanDelete();

  // async=true, show_hidden=false
  int result = WiFi.scanNetworks(true, false);

  // Sur ESP8266 un scan asynchrone renvoie normalement WIFI_SCAN_RUNNING (-1).
  // Une autre valeur negative est traitee comme un echec de lancement.
  if (result < -1) {
    wifiScanRunning = false;
    wifiScanFailed = true;
    Serial.println(F("[WIFI SCAN] ECHEC lancement"));
  }
}

void finishWiFiScan(int n) {
  clearWiFiScanResults();

  Serial.println("[WIFI SCAN] Resultat brut = " + String(n));

  if (n <= 0) {
    wifiScanRunning = false;
    wifiScanReady = true;
    wifiScanFailed = false;
    WiFi.scanDelete();

    Serial.println(F("[WIFI SCAN] Aucun reseau trouve"));
    return;
  }

  for (int i = 0; i < n && wifiScanItemCount < WIFI_SCAN_MAX_RESULTS; i++) {
    String ssid = WiFi.SSID(i);

    if (ssid.length() == 0) continue;

    // Evite les doublons de SSID dans la liste affichee.
    bool duplicate = false;

    for (uint8_t j = 0; j < wifiScanItemCount; j++) {
      if (ssid == String(wifiScanItems[j].ssid)) {
        duplicate = true;

        // Si le meme SSID est vu plusieurs fois, conserve le meilleur RSSI.
        if (WiFi.RSSI(i) > wifiScanItems[j].rssi) {
          wifiScanItems[j].rssi = WiFi.RSSI(i);
          wifiScanItems[j].channel = WiFi.channel(i);
          wifiScanItems[j].secure = WiFi.encryptionType(i) != ENC_TYPE_NONE;
          wifiScanItems[j].saved = isKnownWiFi(ssid);
        }

        break;
      }
    }

    if (duplicate) continue;

    WiFiScanItem& item = wifiScanItems[wifiScanItemCount];

    ssid.toCharArray(item.ssid, sizeof(item.ssid));
    item.rssi = WiFi.RSSI(i);
    item.channel = WiFi.channel(i);
    item.secure = WiFi.encryptionType(i) != ENC_TYPE_NONE;
    item.saved = isKnownWiFi(ssid);

    wifiScanItemCount++;
  }

  // Trie du meilleur au plus faible signal.
  for (uint8_t i = 0; i < wifiScanItemCount; i++) {
    for (uint8_t j = i + 1; j < wifiScanItemCount; j++) {
      if (wifiScanItems[j].rssi > wifiScanItems[i].rssi) {
        WiFiScanItem tmp = wifiScanItems[i];
        wifiScanItems[i] = wifiScanItems[j];
        wifiScanItems[j] = tmp;
      }
    }
  }

  WiFi.scanDelete();

  wifiScanRunning = false;
  wifiScanReady = true;
  wifiScanFailed = false;

  Serial.println(
    "[WIFI SCAN] Termine : " +
    String(wifiScanItemCount) +
    " reseau(x)"
  );
}

void updateWiFiScan() {
  if (wifiScanStartRequested && !wifiScanRunning) {
    wifiScanStartRequested = false;
    beginWiFiScanAsync();
  }

  if (!wifiScanRunning) return;

  int n = WiFi.scanComplete();

  // -1 = scan toujours en cours.
  if (n == -1) return;

  // Toute autre valeur negative = echec.
  if (n < 0) {
    wifiScanRunning = false;
    wifiScanReady = false;
    wifiScanFailed = true;
    WiFi.scanDelete();

    Serial.println(F("[WIFI SCAN] ECHEC pendant le scan"));
    return;
  }

  finishWiFiScan(n);
}

void handleWiFiScanStart() {
  Serial.println(F("[WIFI SCAN] Demande recue depuis interface"));

  // Si un scan est deja actif, l'interface peut simplement continuer
  // a interroger /result.
  if (wifiScanRunning || wifiScanStartRequested) {
    server.send(
      200,
      "application/json",
      "{\"ok\":true,\"state\":\"running\"}"
    );
    return;
  }

  wifiScanReady = false;
  wifiScanFailed = false;
  wifiScanStartRequested = true;

  // La reponse HTTP part AVANT le balayage radio.
  server.sendHeader("Connection","close");
  server.send(
    200,
    "application/json",
    "{\"ok\":true,\"state\":\"starting\"}"
  );
}

void handleWiFiScanResult() {
  String json;
  json.reserve(3500);

  if (wifiScanFailed) {
    server.send(
      200,
      "application/json",
      "{\"state\":\"failed\",\"networks\":[]}"
    );
    return;
  }

  if (wifiScanRunning || wifiScanStartRequested) {
    server.send(
      200,
      "application/json",
      "{\"state\":\"running\",\"networks\":[]}"
    );
    return;
  }

  if (!wifiScanReady) {
    server.send(
      200,
      "application/json",
      "{\"state\":\"idle\",\"networks\":[]}"
    );
    return;
  }

  json = F("{\"state\":\"ready\",\"networks\":[");

  for (uint8_t i = 0; i < wifiScanItemCount; i++) {
    if (i > 0) json += F(",");

    json += F("{");
    json += "\"ssid\":\"" + jsonEscape(String(wifiScanItems[i].ssid)) + "\",";
    json += "\"rssi\":" + String(wifiScanItems[i].rssi) + ",";
    json += "\"channel\":" + String(wifiScanItems[i].channel) + ",";
    json += F("\"secure\":");
    json += wifiScanItems[i].secure ? "true" : "false";
    json += F(",");
    json += F("\"saved\":");
    json += wifiScanItems[i].saved ? "true" : "false";
    json += F("}");
  }

  json += F("]}");

  server.send(200, "application/json; charset=utf-8", json);
}

void handleSaveExternalWiFi() {
  bool enabled = server.hasArg("externalWiFiEnabled");

  String ssid = server.arg("externalSSID");
  String password = server.arg("externalPassword");
  ssid.trim();

  if (enabled && ssid.length() == 0 && config.knownWiFiCount == 0) {
    server.send_P(400,PSTR("text/plain; charset=utf-8"),PSTR("Selectionne au moins un Wi-Fi a memoriser"));
    return;
  }

  if (ssid.length() > 32) {
    server.send_P(400,PSTR("text/plain; charset=utf-8"),PSTR("SSID externe invalide"));
    return;
  }

  if (password.length() > 0 && password.length() < 8) {
    server.send_P(400,PSTR("text/plain; charset=utf-8"),PSTR("Mot de passe externe : minimum 8 caracteres"));
    return;
  }

  config.externalWiFiEnabled = enabled;

  if (ssid.length() > 0) {
    int knownIndex = findKnownWiFi(ssid);

    if (knownIndex < 0 || password.length() > 0) {
      rememberWiFi(ssid, password);
    } else {
      // Reseau deja memorise + champ mot de passe vide :
      // on conserve le mot de passe et on remonte ce reseau en priorite 1.
      rememberWiFi(ssid, "");
    }
  }

  saveConfig();

  // IMPORTANT :
  // on ne redemarre PLUS l'ESP.
  // La nouvelle connexion sera appliquee dans loop() apres que cette
  // reponse HTTP ait ete entierement envoyee au telephone.
  pendingExternalWiFiApply = true;
  pendingExternalWiFiApplyAt = millis() + EXTERNAL_APPLY_DELAY_MS;

  String page;
  page.reserve(2400);

  page = F("<!doctype html><html lang='fr'><head><meta charset='utf-8'>"
    "<meta name='viewport' content='width=device-width,initial-scale=1'>"
    "<style>"
    "body{font-family:Arial;background:#090b0e;color:#fff;padding:22px}"
    ".box{max-width:560px;margin:auto;background:#14181d;border:1px solid #2a3139;border-radius:16px;padding:20px}"
    "a{display:block;margin-top:12px;padding:14px;border-radius:12px;background:#2878d0;color:#fff;text-decoration:none;text-align:center;font-weight:bold}"
    "</style></head><body><div class='box'>");

  if (enabled) {
    page += F("<h2>Wi-Fi memorise</h2>");

    if (ssid.length() > 0) {
      page += "<p>Reseau : <b>" + htmlEscape(ssid) + "</b></p>";
    }

    if (WiFi.status() == WL_CONNECTED &&
        ssid.length() > 0 &&
        WiFi.SSID() == ssid) {

      page += F("<p>L ESP est deja connecte a ce reseau. <b>Aucun redemarrage.</b></p>");
    } else {
      page += F("<p>Connexion en cours. <b>L ESP ne redemarre pas.</b></p>");
      page += F("<p>Le Wi-Fi ON_AIR-MOC reste actif. Il peut y avoir une tres courte coupure radio pendant le changement de canal.</p>");
    }

    page += F("<p>Depuis le meme routeur, utilise ensuite : <b>http://onair-moc.local</b></p>");
  } else {
    page += F("<h2>Wi-Fi externe desactive</h2>");
    page += F("<p>Le boitier reste accessible sur ON_AIR-MOC / 192.168.4.1.</p>");
  }

  page += F("<a href='/settings'>RETOUR AUX PARAMETRES</a>");
  page += F("<a href='/'>CONTROLE</a>");
  page += F("</div></body></html>");

  server.sendHeader("Cache-Control", "no-store");
  server.sendHeader("Connection", "close");
  server.send(200, "text/html; charset=utf-8", page);

  Serial.println(F("[WIFI EXT] Configuration sauvegardee SANS redemarrage"));
}

void handleForgetWiFi() {
  int index = server.arg("i").toInt();

  if (index < 0 || index >= config.knownWiFiCount) {
    server.send_P(400,PSTR("text/plain"),PSTR("Index Wi-Fi invalide"));
    return;
  }

  String removed = config.knownWiFi[index].ssid;
  bool wasConnected = WiFi.status() == WL_CONNECTED && WiFi.SSID() == removed;

  forgetKnownWiFi((uint8_t)index);
  saveConfig();

  if (wasConnected) {
    WiFi.disconnect();
    externalConnectStarted = false;
    mdnsStarted = false;
  }

  server.send_P(200,PSTR("text/plain"),PSTR("OK"));
}

bool readMacroRequest(uint8_t& idx,
                      String& name,
                      uint8_t& directR,
                      uint8_t& directG,
                      uint8_t& directB,
                      uint8_t& directIntensity,
                      bool& idleOff,
                      uint8_t& idleR,
                      uint8_t& idleG,
                      uint8_t& idleB,
                      uint8_t& idleIntensity,
                      uint8_t& alertAnimation,
                      uint8_t& alertDuration,
                      uint16_t& blinkMs) {

  int rawIndex = server.arg("i").toInt();

  if (rawIndex < 0 || rawIndex >= MACRO_COUNT) {
    return false;
  }

  idx = (uint8_t)rawIndex;

  name = server.arg("name");
  name.trim();

  if (name.length() < 1 || name.length() > 24) {
    return false;
  }

  if (!parseHexColor(server.arg("directColor"), directR, directG, directB)) {
    return false;
  }

  if (!parseHexColor(server.arg("idleColor"), idleR, idleG, idleB)) {
    return false;
  }

  directIntensity = constrain(server.arg("directIntensity").toInt(), 0, 100);
  idleIntensity = constrain(server.arg("idleIntensity").toInt(), 0, 100);
  idleOff = server.arg("idleOff") == "1";

  int requestedAnimation=server.arg("alertAnimation").toInt();
  alertAnimation=(requestedAnimation>=0&&requestedAnimation<=ALERT_CUSTOM)||isLibraryId(requestedAnimation)?requestedAnimation:ALERT_CLASSIC;
  alertDuration = constrain(server.arg("alertDuration").toInt(), 1, 60);
  blinkMs = constrain(server.arg("blinkMs").toInt(), 100, 2000);

  return true;
}

void updateMacroFromRequest(uint8_t idx,
                            const String& name,
                            uint8_t directR,
                            uint8_t directG,
                            uint8_t directB,
                            uint8_t directIntensity,
                            bool idleOff,
                            uint8_t idleR,
                            uint8_t idleG,
                            uint8_t idleB,
                            uint8_t idleIntensity,
                            uint8_t alertAnimation,
                            uint8_t alertDuration,
                            uint16_t blinkMs) {

  MacroConfig& m = config.macro[idx];

  name.toCharArray(m.name, sizeof(m.name));

  m.r = directR;
  m.g = directG;
  m.b = directB;
  m.intensity = directIntensity;

  m.idleOff = idleOff;
  m.idleR = idleR;
  m.idleG = idleG;
  m.idleB = idleB;
  m.idleIntensity = idleIntensity;

  m.alertAnimation = alertAnimation;
  m.alertDuration = alertDuration;
  m.blinkMs = blinkMs;
  m.alertEndOn = true;
  readMotionRequest(idx);
}

void handleMacroAutoSave() {
  uint8_t idx;
  String name;

  uint8_t directR, directG, directB, directIntensity;
  bool idleOff;
  uint8_t idleR, idleG, idleB, idleIntensity;
  uint8_t alertAnimation;
  uint8_t alertDuration;
  uint16_t blinkMs;

  if (!readMacroRequest(
        idx,
        name,
        directR,
        directG,
        directB,
        directIntensity,
        idleOff,
        idleR,
        idleG,
        idleB,
        idleIntensity,
        alertAnimation,
        alertDuration,
        blinkMs)) {

    server.send_P(400,PSTR("application/json"),PSTR("{\"ok\":false}"));
    return;
  }

  updateMacroFromRequest(
    idx,
    name,
    directR,
    directG,
    directB,
    directIntensity,
    idleOff,
    idleR,
    idleG,
    idleB,
    idleIntensity,
    alertAnimation,
    alertDuration,
    blinkMs
  );

  if(!saveMotionSettings()){
    server.send_P(500,PSTR("application/json"),PSTR("{\"ok\":false,\"reason\":\"motion storage\"}"));return;
  }
  saveConfig();

  // Si c'est la macro courante, applique son nouvel etat sans attendre.
  if (!settingsPreviewActive &&
      !alertRunning &&
      activeMacro == idx) {
    renderCurrentOutput();
  }

  server.send_P(200,PSTR("application/json"),PSTR("{\"ok\":true}"));
}

void handleMacroPreview() {
  if (alertRunning) {
    server.send_P(409,PSTR("application/json"),PSTR("{\"ok\":false,\"reason\":\"alert\"}"));
    return;
  }

  uint8_t idx;
  String name;

  uint8_t directR, directG, directB, directIntensity;
  bool idleOff;
  uint8_t idleR, idleG, idleB, idleIntensity;
  uint8_t alertAnimation;
  uint8_t alertDuration;
  uint16_t blinkMs;

  if (!readMacroRequest(
        idx,
        name,
        directR,
        directG,
        directB,
        directIntensity,
        idleOff,
        idleR,
        idleG,
        idleB,
        idleIntensity,
        alertAnimation,
        alertDuration,
        blinkMs)) {

    server.send_P(400,PSTR("application/json"),PSTR("{\"ok\":false}"));
    return;
  }

  // L'apercu travaille en RAM pour rester fluide :
  // l'EEPROM est ecrite seulement par l'autosave.
  updateMacroFromRequest(
    idx,
    name,
    directR,
    directG,
    directB,
    directIntensity,
    idleOff,
    idleR,
    idleG,
    idleB,
    idleIntensity,
    alertAnimation,
    alertDuration,
    blinkMs
  );

  bool directState = server.arg("state") == "direct";

  showMacroPreview(idx, directState);

  server.send_P(200,PSTR("application/json"),PSTR("{\"ok\":true}"));
}


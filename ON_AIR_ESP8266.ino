void setupWebServer() {
  server.on("/style.css",HTTP_GET,handleStyleCSS);

  server.on("/",HTTP_GET,sendControlPage);

  server.on("/settings",HTTP_GET,sendSettingsPage);

  server.on("/macro",HTTP_GET,[](){
    if (!server.hasArg("i")) {
      server.send(400,"text/plain","Macro invalide");
      return;
    }

    int i = server.arg("i").toInt();

    if (i < 0 || i >= MACRO_COUNT) {
      server.send(400,"text/plain","Macro invalide");
      return;
    }

    sendMacroSettingsPage((uint8_t)i);
  });
  server.on("/ping",HTTP_GET,[](){
    server.sendHeader("Connection","close");
    server.send(200,"text/plain","ON_AIR-MOC OK");
  });

  server.on("/diagnostics",HTTP_GET,sendDiagnosticsPage);

  server.on("/config/export",HTTP_GET,handleConfigExport);
  server.on("/config/import",HTTP_POST,handleConfigImportComplete,handleConfigImportData);
  server.on("/api/status",HTTP_GET,handleStatus);
  server.on("/api/uihealth",HTTP_GET,[](){
    server.send(200,"application/json","{\"css\":true,\"version\":\"2.9\"}");
  });
  server.on("/api/direct",HTTP_GET,handleDirect);
  server.on("/api/alert",HTTP_GET,handleAlert);
  server.on("/api/alertTest",HTTP_GET,handleAlertTest);
  server.on("/api/off",HTTP_GET,handleOff);
  server.on("/api/startup",HTTP_GET,handleStartupTest);
  server.on("/api/wifiscan/start",HTTP_GET,handleWiFiScanStart);
  server.on("/api/wifiscan/result",HTTP_GET,handleWiFiScanResult);
  server.on("/api/macroSave",HTTP_GET,handleMacroAutoSave);
  server.on("/api/macroPreview",HTTP_GET,handleMacroPreview);
  server.on("/saveGeneral",HTTP_POST,handleSaveGeneral);
  server.on("/saveExternalWiFi",HTTP_POST,handleSaveExternalWiFi);
  server.on("/forgetWiFi",HTTP_POST,handleForgetWiFi);
  server.on("/saveMacro",HTTP_POST,handleSaveMacro);
  server.on("/uploadLogo",HTTP_POST,handleUploadLogoComplete,handleUploadLogoData);
  server.on("/deleteLogo",HTTP_POST,handleDeleteLogo);
  server.on("/logo",HTTP_GET,handleLogo);
  server.on("/reboot",HTTP_POST,handleReboot);
  server.on("/factoryReset",HTTP_POST,handleFactoryReset);

  // Un navigateur peut conserver l'URL du formulaire apres le redemarrage.
  // Ces GET evitent alors un faux 404.
  server.on("/saveGeneral",HTTP_GET,redirectHome);
  server.on("/saveExternalWiFi",HTTP_GET,redirectHome);
  server.on("/saveMacro",HTTP_GET,redirectHome);
  server.on("/uploadLogo",HTTP_GET,redirectHome);

  // Reponses propres aux tests de connectivite des telephones.
  // On ne redirige plus ces requetes vers l'interface :
  // cela pouvait provoquer des boucles de portail captif sur certains mobiles.
  server.on("/generate_204",HTTP_GET,[](){
    server.send(204,"text/plain","");
  });

  server.on("/hotspot-detect.html",HTTP_GET,[](){
    server.send(
      200,
      "text/html",
      "<HTML><HEAD><TITLE>Success</TITLE></HEAD><BODY>Success</BODY></HTML>"
    );
  });

  server.on("/connecttest.txt",HTTP_GET,[](){
    server.send(200,"text/plain","Microsoft Connect Test");
  });

  server.on("/ncsi.txt",HTTP_GET,[](){
    server.send(200,"text/plain","Microsoft NCSI");
  });

  server.on("/fwlink",HTTP_GET,[](){
    server.send(204,"text/plain","");
  });

  // Une URL inconnue retourne une vraie 404.
  // Pas de redirection automatique = pas de boucle navigateur.
  server.onNotFound([](){
    Serial.println("[WEB] 404 " + server.uri());
    server.sendHeader("Connection","close");
    server.send(404,"text/plain","404");
  });

  httpUpdater.setup(&server, "/update");

  server.begin();
  Serial.println("[WEB] Serveur HTTP demarre");
  Serial.println("[OTA] Interface : /update");
}

void startAccessPoint() {
  Serial.println();
  Serial.println("[WIFI AP] Initialisation...");

  WiFi.persistent(false);
  WiFi.mode(WIFI_OFF);
  delay(250);

  // Si le Wi-Fi externe est active, l'ESP travaille simultanement
  // en point d'acces + station.
  WiFi.mode(config.externalWiFiEnabled ? WIFI_AP_STA : WIFI_AP);
  delay(250);

  bool ipOK = WiFi.softAPConfig(AP_IP, AP_GW, AP_MASK);
  Serial.println("[WIFI AP] Config IP = " + String(ipOK ? "OK" : "ECHEC"));

  bool ok = WiFi.softAP(
    config.apSSID,
    config.apPassword,
    6,
    false,
    4
  );

  delay(300);

  if (ok) {
    Serial.println("[WIFI AP] OK");
    Serial.println("[WIFI AP] SSID = " + String(config.apSSID));
    Serial.println("[WIFI AP] IP = " + WiFi.softAPIP().toString());

    // Priorite a la reactivite de l'interface.
    WiFi.setSleepMode(WIFI_NONE_SLEEP);
    Serial.println("[WIFI AP] Sleep Wi-Fi desactive pour stabilite");

  } else {
    Serial.println("[WIFI AP] ECHEC du reseau securise");
    Serial.println("[WIFI AP] Tentative ONAIR-RECOVERY sans mot de passe");

    WiFi.softAPdisconnect(true);
    delay(250);

    WiFi.mode(config.externalWiFiEnabled ? WIFI_AP_STA : WIFI_AP);
    WiFi.softAPConfig(AP_IP, AP_GW, AP_MASK);

    bool recoveryOK = WiFi.softAP("ONAIR-RECOVERY", nullptr, 6, false, 4);

    if (recoveryOK) {
      Serial.println("[WIFI AP] RECOVERY OK");
      Serial.println("[WIFI AP] IP = " + WiFi.softAPIP().toString());
      WiFi.setSleepMode(WIFI_NONE_SLEEP);
    } else {
      Serial.println("[WIFI AP] ECHEC TOTAL");
    }
  }
}

bool connectBestKnownWiFi() {
  if (!config.externalWiFiEnabled || config.knownWiFiCount == 0) {
    return false;
  }

  Serial.println();
  Serial.println("[WIFI EXT] Recherche du meilleur reseau memorise...");

  if (WiFi.getMode() != WIFI_AP_STA) {
    WiFi.mode(WIFI_AP_STA);
    delay(100);
  }

  WiFi.hostname(MDNS_HOSTNAME);

  WiFi.scanDelete();
  int n = WiFi.scanNetworks(false, false);

  int bestKnown = -1;
  int32_t bestRSSI = -1000;

  if (n > 0) {
    for (int scanIndex = 0; scanIndex < n; scanIndex++) {
      String seenSSID = WiFi.SSID(scanIndex);
      int knownIndex = findKnownWiFi(seenSSID);

      if (knownIndex >= 0 && WiFi.RSSI(scanIndex) > bestRSSI) {
        bestRSSI = WiFi.RSSI(scanIndex);
        bestKnown = knownIndex;
      }
    }
  }

  WiFi.scanDelete();

  if (bestKnown < 0) {
    Serial.println("[WIFI EXT] Aucun reseau memorise disponible");
    currentKnownWiFiAttempt = -1;
    return false;
  }

  currentKnownWiFiAttempt = bestKnown;

  Serial.println(
    "[WIFI EXT] Connexion a " +
    String(config.knownWiFi[bestKnown].ssid) +
    " | RSSI " + String(bestRSSI) + " dBm"
  );

  WiFi.begin(
    config.knownWiFi[bestKnown].ssid,
    config.knownWiFi[bestKnown].password
  );

  externalConnectStarted = true;
  lastExternalReconnectAt = millis();

  return true;
}

void startMDNSIfPossible();

void applyPendingExternalWiFi() {
  if (!pendingExternalWiFiApply) return;

  if ((long)(millis() - pendingExternalWiFiApplyAt) < 0) {
    return;
  }

  pendingExternalWiFiApply = false;

  if (!config.externalWiFiEnabled) {
    Serial.println("[WIFI EXT] Desactivation a chaud");

    // Deconnecte uniquement la partie station.
    WiFi.disconnect(false);
    externalConnectStarted = false;
    currentKnownWiFiAttempt = -1;
    mdnsStarted = false;

    // Le point d'acces ON_AIR-MOC reste present.
    if (WiFi.getMode() != WIFI_AP) {
      WiFi.mode(WIFI_AP);
    }

    return;
  }

  if (config.knownWiFiCount == 0) {
    Serial.println("[WIFI EXT] Aucun reseau memorise a appliquer");
    return;
  }

  const char* targetSSID = config.knownWiFi[0].ssid;
  const char* targetPassword = config.knownWiFi[0].password;

  // Si on est deja connecte au reseau demande, ne touche a rien.
  if (WiFi.status() == WL_CONNECTED &&
      WiFi.SSID() == String(targetSSID)) {

    Serial.println(
      "[WIFI EXT] Deja connecte a " +
      String(targetSSID) +
      " | IP=" + WiFi.localIP().toString()
    );

    externalConnectStarted = true;
    lastExternalReconnectAt = millis();

    startMDNSIfPossible();
    return;
  }

  Serial.println(
    "[WIFI EXT] Connexion a chaud vers " +
    String(targetSSID) +
    " (sans reboot)"
  );

  if (WiFi.getMode() != WIFI_AP_STA) {
    WiFi.mode(WIFI_AP_STA);
    delay(20);
  }

  WiFi.hostname(MDNS_HOSTNAME);

  // Coupe/reinitialise uniquement le client STA.
  WiFi.disconnect(false);
  delay(20);

  mdnsStarted = false;

  WiFi.begin(targetSSID, targetPassword);

  externalConnectStarted = true;
  currentKnownWiFiAttempt = 0;
  lastExternalReconnectAt = millis();
}

void startExternalWiFi() {
  if (!config.externalWiFiEnabled) {
    Serial.println("[WIFI EXT] Desactive");
    return;
  }

  if (config.knownWiFiCount == 0) {
    Serial.println("[WIFI EXT] Aucun Wi-Fi memorise");
    return;
  }

  connectBestKnownWiFi();
}

void startMDNSIfPossible() {
  if (mdnsStarted || WiFi.status() != WL_CONNECTED) return;

  if (MDNS.begin(MDNS_HOSTNAME)) {
    MDNS.addService("http", "tcp", 80);
    mdnsStarted = true;

    Serial.println("[mDNS] OK");
    Serial.println("[mDNS] http://" + String(MDNS_HOSTNAME) + ".local");
  } else {
    Serial.println("[mDNS] ECHEC");
  }
}

void updateExternalWiFi() {
  if (!config.externalWiFiEnabled || config.knownWiFiCount == 0) return;

  // Ne lance jamais un second scan pendant une operation manuelle.
  if (wifiScanRunning || wifiScanStartRequested || pendingExternalWiFiApply) return;

  if (WiFi.status() == WL_CONNECTED) {
    startMDNSIfPossible();
    return;
  }

  mdnsStarted = false;

  unsigned long now = millis();

  if (!externalConnectStarted ||
      now - lastExternalReconnectAt >= EXTERNAL_RECONNECT_MS) {

    // Un scan automatique peut faire sauter momentanement un client
    // connecte directement a ON_AIR-MOC. On privilegie donc l'interface :
    // tant qu'un telephone est sur l'AP, aucun scan automatique.
    if (WiFi.softAPgetStationNum() > 0) {
      return;
    }

    externalConnectStarted = true;
    lastExternalReconnectAt = now;

    connectBestKnownWiFi();
  }
}

void setup() {
  Serial.begin(115200);
  delay(150);
  Serial.println();
  Serial.println("===========================================");
  Serial.println(" CARAC ON AIR MANUAL - ESP8266");
  Serial.println(" Firmware " + String(FIRMWARE_VERSION));
  Serial.println("===========================================");

  pinMode(PIN_RED,OUTPUT);
  pinMode(PIN_GREEN,OUTPUT);
  pinMode(PIN_BLUE,OUTPUT);
  analogWriteRange(PWM_MAX);
  ledsOff();

  if (!LittleFS.begin()) Serial.println("[FS] ECHEC LittleFS");
  else Serial.println("[FS] LittleFS OK");

  loadConfig();

  // Le Wi-Fi apparait immediatement au demarrage.
  startAccessPoint();
  setupWebServer();
  startExternalWiFi();

  startupAnimation();
  blackout();

  Serial.println("[READY] Wi-Fi autonome : " + String(config.apSSID));
  Serial.println("[READY] Acces direct GARANTI : http://192.168.4.1");
  Serial.println("[READY] .local uniquement sur le Wi-Fi externe");
  if (config.externalWiFiEnabled) {
    Serial.println("[READY] Wi-Fi memorises : " + String(config.knownWiFiCount));
    Serial.println("[READY] Acces stable via routeur : http://onair-moc.local");
  }
}

void loop() {
  // Le serveur HTTP est toujours prioritaire.
  server.handleClient();

  updateAlert();
  updateSettingsPreview();
  updateWiFiScan();
  applyPendingExternalWiFi();
  updateExternalWiFi();

  if (mdnsStarted) {
    MDNS.update();
  }

  static unsigned long lastAPDiag = 0;
  if (millis() - lastAPDiag >= 15000UL) {
    lastAPDiag = millis();

    Serial.println(
      "[WIFI AP] Actif | IP=" + WiFi.softAPIP().toString() +
      " | clients=" + String(WiFi.softAPgetStationNum())
    );

    if (config.externalWiFiEnabled) {
      if (WiFi.status() == WL_CONNECTED) {
        Serial.println(
          "[WIFI EXT] CONNECTE | SSID=" + WiFi.SSID() +
          " | IP=" + WiFi.localIP().toString()
        );
      } else {
        Serial.println("[WIFI EXT] NON CONNECTE");
      }
    }
  }

  yield();
}
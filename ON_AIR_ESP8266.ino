void handleUploadLogoData() {
  HTTPUpload& upload = server.upload();

  if (upload.status == UPLOAD_FILE_START) {
    uploadAccepted = false;
    uploadTargetMacro = server.arg("i").toInt();
    if (uploadTargetMacro < 0 || uploadTargetMacro >= MACRO_COUNT) return;
    if (!validImageExtension(upload.filename)) return;

    uploadTargetPath = logoPathFor(uploadTargetMacro, upload.filename);
    String png = "/m" + String(uploadTargetMacro+1) + ".png";
    String jpg = "/m" + String(uploadTargetMacro+1) + ".jpg";
    if (LittleFS.exists(png)) LittleFS.remove(png);
    if (LittleFS.exists(jpg)) LittleFS.remove(jpg);
    uploadFile = LittleFS.open(uploadTargetPath,"w");
    if (uploadFile) uploadAccepted = true;
  }
  else if (upload.status == UPLOAD_FILE_WRITE) {
    if (uploadAccepted && uploadFile) uploadFile.write(upload.buf, upload.currentSize);
  }
  else if (upload.status == UPLOAD_FILE_END) {
    if (uploadFile) uploadFile.close();
    if (uploadAccepted && uploadTargetMacro >= 0 && uploadTargetMacro < MACRO_COUNT) {
      uploadTargetPath.toCharArray(config.macro[uploadTargetMacro].logoPath, sizeof(config.macro[uploadTargetMacro].logoPath));
      saveConfig();
    }
  }
  else if (upload.status == UPLOAD_FILE_ABORTED) {
    if (uploadFile) uploadFile.close();
    if (uploadTargetPath.length() && LittleFS.exists(uploadTargetPath)) LittleFS.remove(uploadTargetPath);
    uploadAccepted = false;
  }
}

void handleUploadLogoComplete() {
  if (!uploadAccepted) { server.send(400,"text/plain","Upload refuse. Utiliser PNG ou JPG."); return; }
  redirectSettings();
}


void loadConfig() {
  EEPROM.begin(EEPROM_SIZE);

  uint32_t magic = 0;
  EEPROM.get(0, magic);

  if (magic == CONFIG_MAGIC) {
    EEPROM.get(0, config);
  }
  else if (magic == LEGACY_CONFIG_MAGIC_V25) {
    ConfigV25 oldConfig;
    EEPROM.get(0, oldConfig);

    setDefaults();

    strlcpy(config.apSSID, oldConfig.apSSID, sizeof(config.apSSID));
    strlcpy(config.apPassword, oldConfig.apPassword, sizeof(config.apPassword));
    strlcpy(config.deviceName, oldConfig.deviceName, sizeof(config.deviceName));
    config.startupAnimation = oldConfig.startupAnimation;

    config.externalWiFiEnabled = oldConfig.externalWiFiEnabled;
    config.knownWiFiCount = min(oldConfig.knownWiFiCount, MAX_KNOWN_WIFI);

    for (uint8_t i = 0; i < MAX_KNOWN_WIFI; i++) {
      config.knownWiFi[i] = oldConfig.knownWiFi[i];
    }

    for (uint8_t i = 0; i < MACRO_COUNT; i++) {
      copyV25MacroToV26(oldConfig.macro[i], config.macro[i]);
    }

    config.magic = CONFIG_MAGIC;
    saveConfig();

    Serial.println("[CONFIG] Migration V2.5 -> V2.6 effectuee");
  }
  else if (magic == LEGACY_CONFIG_MAGIC_V19) {
    ConfigV19 oldConfig;
    EEPROM.get(0, oldConfig);

    setDefaults();

    strlcpy(config.apSSID, oldConfig.apSSID, sizeof(config.apSSID));
    strlcpy(config.apPassword, oldConfig.apPassword, sizeof(config.apPassword));
    strlcpy(config.deviceName, oldConfig.deviceName, sizeof(config.deviceName));
    config.startupAnimation = oldConfig.startupAnimation;

    config.externalWiFiEnabled = oldConfig.externalWiFiEnabled;
    config.knownWiFiCount = min(oldConfig.knownWiFiCount, MAX_KNOWN_WIFI);

    for (uint8_t i = 0; i < MAX_KNOWN_WIFI; i++) {
      config.knownWiFi[i] = oldConfig.knownWiFi[i];
    }

    for (uint8_t i = 0; i < MACRO_COUNT; i++) {
      copyLegacyMacroToV2(oldConfig.macro[i], config.macro[i]);
    }

    config.magic = CONFIG_MAGIC;
    saveConfig();

    Serial.println("[CONFIG] Migration V1.9 -> V2.0 effectuee");
  }
  else if (magic == LEGACY_CONFIG_MAGIC_V18 ||
           magic == LEGACY_CONFIG_MAGIC_V14 ||
           magic == LEGACY_CONFIG_MAGIC_V12) {

    ConfigSingleWiFi oldConfig;
    EEPROM.get(0, oldConfig);

    setDefaults();

    strlcpy(config.apSSID, oldConfig.apSSID, sizeof(config.apSSID));
    strlcpy(config.apPassword, oldConfig.apPassword, sizeof(config.apPassword));
    strlcpy(config.deviceName, oldConfig.deviceName, sizeof(config.deviceName));
    config.startupAnimation = oldConfig.startupAnimation;

    config.externalWiFiEnabled = oldConfig.externalWiFiEnabled;

    for (uint8_t i = 0; i < MACRO_COUNT; i++) {
      copyLegacyMacroToV2(oldConfig.macro[i], config.macro[i]);
    }

    if (strlen(oldConfig.externalSSID) > 0) {
      rememberWiFi(
        String(oldConfig.externalSSID),
        String(oldConfig.externalPassword)
      );
    }

    config.magic = CONFIG_MAGIC;
    saveConfig();

    Serial.println("[CONFIG] Migration ancienne version -> V2.0 effectuee");
  }
  else if (magic == LEGACY_CONFIG_MAGIC_V11) {
    ConfigV11 oldConfig;
    EEPROM.get(0, oldConfig);

    setDefaults();

    strlcpy(config.apSSID, oldConfig.apSSID, sizeof(config.apSSID));
    strlcpy(config.apPassword, oldConfig.apPassword, sizeof(config.apPassword));
    strlcpy(config.deviceName, oldConfig.deviceName, sizeof(config.deviceName));
    config.startupAnimation = oldConfig.startupAnimation;

    for (uint8_t i = 0; i < MACRO_COUNT; i++) {
      copyLegacyMacroToV2(oldConfig.macro[i], config.macro[i]);
    }

    config.magic = CONFIG_MAGIC;
    saveConfig();

    Serial.println("[CONFIG] Migration V1.1 -> V2.0 effectuee");
  }
  else {
    setDefaults();
    saveConfig();
  }

  config.apSSID[sizeof(config.apSSID)-1] = '\0';
  config.apPassword[sizeof(config.apPassword)-1] = '\0';
  config.deviceName[sizeof(config.deviceName)-1] = '\0';

  config.knownWiFiCount = min(config.knownWiFiCount, MAX_KNOWN_WIFI);

  for (uint8_t i = 0; i < MAX_KNOWN_WIFI; i++) {
    config.knownWiFi[i].ssid[sizeof(config.knownWiFi[i].ssid)-1] = '\0';
    config.knownWiFi[i].password[sizeof(config.knownWiFi[i].password)-1] = '\0';
  }

  for (uint8_t i = 0; i < MACRO_COUNT; i++) {
    config.macro[i].name[sizeof(config.macro[i].name)-1] = '\0';
    config.macro[i].logoPath[sizeof(config.macro[i].logoPath)-1] = '\0';

    config.macro[i].intensity = constrain(config.macro[i].intensity, 0, 100);
    config.macro[i].idleIntensity = constrain(config.macro[i].idleIntensity, 0, 100);
    config.macro[i].alertAnimation = constrain(config.macro[i].alertAnimation, (uint8_t)ALERT_CLASSIC, (uint8_t)ALERT_DOUBLE_FLASH);
    config.macro[i].alertDuration = constrain(config.macro[i].alertDuration, 1, 60);
    config.macro[i].blinkMs = constrain(config.macro[i].blinkMs, 100, 2000);
    config.macro[i].alertEndOn = true;
  }
}

void setRGBLevel(uint8_t r, uint8_t g, uint8_t b, uint8_t intensity) {
  currentLedR = r;
  currentLedG = g;
  currentLedB = b;
  currentLedIntensity = constrain((int)intensity, 0, 100);

  float f = currentLedIntensity / 100.0f;
  int rr = map((int)(r * f), 0, 255, 0, PWM_MAX);
  int gg = map((int)(g * f), 0, 255, 0, PWM_MAX);
  int bb = map((int)(b * f), 0, 255, 0, PWM_MAX);
  analogWrite(PIN_RED, rr);
  analogWrite(PIN_GREEN, gg);
  analogWrite(PIN_BLUE, bb);
}

void ledsOff() {
  currentLedR = 0;
  currentLedG = 0;
  currentLedB = 0;
  currentLedIntensity = 0;

  analogWrite(PIN_RED, 0);
  analogWrite(PIN_GREEN, 0);
  analogWrite(PIN_BLUE, 0);
}

void renderMacroDirect(uint8_t i) {
  if (i >= MACRO_COUNT) return;

  MacroConfig& m = config.macro[i];
  setRGBLevel(m.r, m.g, m.b, m.intensity);
}

void renderMacroIdle(uint8_t i) {
  if (i >= MACRO_COUNT) {
    ledsOff();
    return;
  }

  MacroConfig& m = config.macro[i];

  if (m.idleOff || m.idleIntensity == 0) {
    ledsOff();
  } else {
    setRGBLevel(m.idleR, m.idleG, m.idleB, m.idleIntensity);
  }
}

void renderCurrentOutput() {
  if (alertRunning) return;

  if (activeMacro < 0 || activeMacro >= MACRO_COUNT) {
    ledsOff();
    return;
  }

  if (outputEnabled) {
    renderMacroDirect(activeMacro);
  } else {
    renderMacroIdle(activeMacro);
  }
}

void applyMacro(uint8_t i) {
  if (i >= MACRO_COUNT) return;

  settingsPreviewActive = false;
  alertRunning = false;
  alertMacro = -1;

  activeMacro = i;
  outputEnabled = true;

  renderMacroDirect(i);

  Serial.println("[MACRO] DIRECT " + String(i+1) + " - " + String(config.macro[i].name));
}

void applyMacroIdle(uint8_t i) {
  if (i >= MACRO_COUNT) return;

  settingsPreviewActive = false;
  alertRunning = false;
  alertMacro = -1;

  activeMacro = i;
  outputEnabled = false;

  renderMacroIdle(i);

  Serial.println("[MACRO] HORS DIRECT " + String(i+1) + " - " + String(config.macro[i].name));
}

void blackout() {
  settingsPreviewActive = false;
  alertRunning = false;
  alertTestMode = false;
  alertMacro = -1;
  activeMacro = -1;
  outputEnabled = false;
  ledsOff();

  Serial.println("[ON AIR] ETEINT / AUCUNE MACRO SELECTIONNEE");
}

void startAlert(uint8_t i, bool testMode = false) {
  if (i >= MACRO_COUNT) return;

  settingsPreviewActive = false;

  alertRunning = true;
  alertTestMode = testMode;
  alertMacro = i;
  activeMacro = i;

  // Pendant la cinematrique on n'est pas encore en DIRECT.
  outputEnabled = false;

  alertStartedAt = millis();
  alertLastToggleAt = millis();
  alertAnimLastFrameAt = 0;
  alertVisible = true;

  renderMacroDirect(i);

  if (alertTestMode) {
    Serial.println("[MACRO] TEST ALERTE " + String(i+1) + " - " + String(config.macro[i].name));
  } else {
    Serial.println("[MACRO] ALERTE " + String(i+1) + " - " + String(config.macro[i].name));
  }
}

uint8_t lerp8(uint8_t a, uint8_t b, float t) {
  if (t < 0.0f) t = 0.0f;
  if (t > 1.0f) t = 1.0f;
  return (uint8_t)(a + (b - a) * t);
}

void renderTrafficGradient(float progress, uint8_t intensity) {
  // Un seul passage sur toute la duree :
  // 0% = vert, 50% = jaune, 100% = rouge.
  if (progress < 0.0f) progress = 0.0f;
  if (progress > 1.0f) progress = 1.0f;

  uint8_t r;
  uint8_t g;

  if (progress <= 0.5f) {
    float t = progress / 0.5f;
    r = lerp8(0, 255, t);
    g = 255;
  } else {
    float t = (progress - 0.5f) / 0.5f;
    r = 255;
    g = lerp8(255, 0, t);
  }

  setRGBLevel(r, g, 0, intensity);
  alertVisible = true;
}

void finishAlert() {
  bool wasTest = alertTestMode;
  int finishedMacro = alertMacro;

  alertRunning = false;
  alertTestMode = false;

  if (wasTest) {
    blackout();
    Serial.println("[ALERTE TEST] Fin -> TOUT ETEINT");
    return;
  }

  // Sortie propre de l'etat ALERTE puis passage DIRECT.
  // Important pour l'interface : le bouton DIRECT devient actif,
  // le bouton ALERTE revient immediatement a son etat normal.
  alertMacro = -1;
  alertVisible = false;

  activeMacro = finishedMacro;
  outputEnabled = true;

  renderMacroDirect(activeMacro);

  Serial.println("[ALERTE] Fin propre -> DIRECT " + String(activeMacro + 1));
}

void updateAlert() {
  if (!alertRunning || alertMacro < 0 || alertMacro >= MACRO_COUNT) return;

  MacroConfig& m = config.macro[alertMacro];

  unsigned long now = millis();
  unsigned long elapsed = now - alertStartedAt;
  unsigned long totalMs = max(1UL, (unsigned long)m.alertDuration * 1000UL);

  if (elapsed >= totalMs) {
    finishAlert();
    return;
  }

  // Progression globale 0.0 -> 1.0 sur EXACTEMENT la duree demandee.
  float progress = (float)elapsed / (float)totalMs;

  switch (m.alertAnimation) {

    case ALERT_FADE_TO_BLACK: {
      // Boucle "flash + fade" :
      // 100 % instantane -> fade progressif jusqu'a 0 % -> retour instantane a 100 %.
      // blinkMs regle la duree d'un cycle complet.
      if (now - alertAnimLastFrameAt < 20UL) return;
      alertAnimLastFrameAt = now;

      unsigned long cycle =
        max(300UL, (unsigned long)m.blinkMs);

      unsigned long pos = elapsed % cycle;
      float cycleProgress = (float)pos / (float)cycle;

      uint8_t level =
        (uint8_t)(100.0f * (1.0f - cycleProgress));

      setRGBLevel(m.r, m.g, m.b, level);
      alertVisible = level > 4;
      break;
    }

    case ALERT_TRAFFIC_GRADIENT: {
      // UN SEUL passage sur toute la duree :
      // vert -> jaune -> rouge.
      if (now - alertAnimLastFrameAt < 20UL) return;
      alertAnimLastFrameAt = now;

      renderTrafficGradient(progress, m.intensity);
      break;
    }

    case ALERT_ACCELERATING: {
      // Toute l'acceleration est calculee sur la duree totale.
      float remain = 1.0f - progress;

      unsigned long startInterval =
        max(300UL, (unsigned long)m.blinkMs * 2UL);

      unsigned long interval =
        60UL +
        (unsigned long)((startInterval - 60UL) * remain * remain);

      if (now - alertLastToggleAt >= interval) {
        alertLastToggleAt = now;
        alertVisible = !alertVisible;

        if (alertVisible) renderMacroDirect(alertMacro);
        else renderMacroIdle(alertMacro);
      }
      break;
    }

    case ALERT_DOUBLE_FLASH: {
      // Heartbeat repete pendant la duree demandee.
      // blinkMs regle ici le rythme du heartbeat.
      if (now - alertAnimLastFrameAt < 20UL) return;
      alertAnimLastFrameAt = now;

      unsigned long pulse =
        constrain((unsigned long)m.blinkMs / 4UL, 55UL, 130UL);

      unsigned long cycle =
        max(500UL, (unsigned long)m.blinkMs * 2UL);

      unsigned long pos = elapsed % cycle;

      bool on =
        (pos < pulse) ||
        (pos >= pulse * 2UL && pos < pulse * 3UL);

      if (on) {
        renderMacroDirect(alertMacro);
        alertVisible = true;
      } else {
        renderMacroIdle(alertMacro);
        alertVisible = false;
      }
      break;
    }

    case ALERT_CLASSIC:
    default: {
      // Clignotement constant pendant toute la duree demandee.
      if (now - alertLastToggleAt >= m.blinkMs) {
        alertLastToggleAt = now;
        alertVisible = !alertVisible;

        if (alertVisible) renderMacroDirect(alertMacro);
        else renderMacroIdle(alertMacro);
      }
      break;
    }
  }
}

void showMacroPreview(uint8_t i, bool directState) {
  if (i >= MACRO_COUNT || alertRunning) return;

  settingsPreviewActive = true;
  settingsPreviewUntil = millis() + SETTINGS_PREVIEW_HOLD_MS;

  if (directState) {
    renderMacroDirect(i);
  } else {
    renderMacroIdle(i);
  }
}

void updateSettingsPreview() {
  if (!settingsPreviewActive || alertRunning) return;

  if ((long)(millis() - settingsPreviewUntil) >= 0) {
    settingsPreviewActive = false;
    renderCurrentOutput();
  }
}

void fadeRGB(uint8_t r1,uint8_t g1,uint8_t b1,uint8_t r2,uint8_t g2,uint8_t b2,uint16_t durationMs) {
  const int steps = 30;
  for (int i = 0; i <= steps; i++) {
    float t = (float)i / (float)steps;
    uint8_t r = r1 + (r2-r1)*t;
    uint8_t g = g1 + (g2-g1)*t;
    uint8_t b = b1 + (b2-b1)*t;
    setRGBLevel(r,g,b,20);
    delay(durationMs / steps);
    yield();
  }
}

void startupAnimation() {
  if (!config.startupAnimation) return;
  fadeRGB(0,0,0,255,0,0,150);
  fadeRGB(255,0,0,255,255,0,150);
  fadeRGB(255,255,0,0,255,0,150);
  fadeRGB(0,255,0,0,255,255,150);
  fadeRGB(0,255,255,0,0,255,150);
  fadeRGB(0,0,255,255,0,255,150);
  fadeRGB(255,0,255,0,0,0,150);
  for (int i=0;i<3;i++) {
    setRGBLevel(255,255,255,20); delay(55);
    ledsOff(); delay(55);
  }
}

String mimeTypeForPath(String path) {
  path.toLowerCase();
  if (path.endsWith(".png")) return "image/png";
  if (path.endsWith(".jpg") || path.endsWith(".jpeg")) return "image/jpeg";
  return "application/octet-stream";
}


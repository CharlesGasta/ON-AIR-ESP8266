async function forgetWiFi(i){
  if(!confirm('Oublier ce reseau Wi-Fi ?'))return;

  await fetch('/forgetWiFi?i='+i,{
    method:'POST',
    cache:'no-store'
  });

  location.reload();
}

function waitMs(ms){
  return new Promise(resolve=>setTimeout(resolve,ms));
}

function renderWiFiResults(data){
  const status=document.getElementById('wifiScanStatus');
  const box=document.getElementById('wifiScanResults');

  if(!data.networks || data.networks.length===0){
    status.textContent='Aucun reseau Wi-Fi 2.4 GHz detecte.';
    box.innerHTML='';
    return;
  }

  status.textContent=
    data.networks.length+
    ' reseau(x) detecte(s). Appuie sur un reseau pour le selectionner.';

  const list=document.createElement('div');
  list.className='wifilist';

  data.networks.forEach(n=>{
    const b=document.createElement('button');
    b.type='button';
    b.className='wifirow';

    const left=document.createElement('div');
    left.style.minWidth='0';

    const name=document.createElement('div');
    name.className='wifiname';
    name.textContent=n.ssid;

    const meta=document.createElement('div');
    meta.className='wifimeta';
    meta.textContent=
      (n.saved?'✓ MEMORISE · ':'')+
      (n.secure?'🔒 ':'🔓 ')+
      signalLabel(n.rssi)+' · '+
      n.rssi+' dBm · canal '+n.channel;

    left.appendChild(name);
    left.appendChild(meta);

    const arrow=document.createElement('div');
    arrow.textContent='›';
    arrow.style.fontSize='26px';

    b.appendChild(left);
    b.appendChild(arrow);
    b.onclick=()=>selectWiFi(n.ssid,n.saved);

    list.appendChild(b);
  });

  box.innerHTML='';
  box.appendChild(list);
}

async function scanWiFi(){
  const btn=document.getElementById('scanWifiBtn');
  const status=document.getElementById('wifiScanStatus');
  const box=document.getElementById('wifiScanResults');

  btn.disabled=true;
  btn.textContent='RECHERCHE...';
  status.textContent='Recherche des reseaux 2.4 GHz...';
  box.innerHTML='';

  try{
    const start=await fetch('/api/wifiscan/start?t='+Date.now(),{
      cache:'no-store'
    });

    if(!start.ok)throw new Error('start HTTP '+start.status);

    for(let attempt=0;attempt<40;attempt++){
      await waitMs(400);

      try{
        const r=await fetch('/api/wifiscan/result?t='+Date.now(),{
          cache:'no-store'
        });

        if(!r.ok)continue;

        const data=await r.json();

        if(data.state==='ready'){
          renderWiFiResults(data);
          return;
        }

        if(data.state==='failed'){
          throw new Error('scan failed');
        }
      }catch(e){}
    }

    status.textContent='Le scan prend trop de temps. Reessaie.';
  }catch(e){
    status.textContent='Erreur detection Wi-Fi : '+e.message;
  }finally{
    btn.disabled=false;
    btn.textContent='📡 DETECTER LES WI-FI';
  }
}


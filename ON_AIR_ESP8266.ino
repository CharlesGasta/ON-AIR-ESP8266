void resetMotionSettings() {
  memset(&motionSettings,0,sizeof(motionSettings));
  motionSettings.magic=MOTION_MAGIC;
  for(uint8_t i=0;i<MACRO_COUNT;i++)motionSettings.cycleMs[i]=4000;
  motionSavedChecksum=0;
}
bool validMotionSettings(const MotionSettings& data) {
  if(data.magic!=MOTION_MAGIC)return false;
  if(configChecksum(reinterpret_cast<const uint8_t*>(&data),sizeof(data)-sizeof(data.checksum))!=data.checksum)return false;
  for(uint8_t i=0;i<MACRO_COUNT;i++)if((data.mode[i]>10&&!isLibraryId(data.mode[i]))||data.cycleMs[i]<1000||data.cycleMs[i]>12000)return false;
  return true;
}
bool saveMotionSettings() {
  motionSettings.checksum=configChecksum(reinterpret_cast<const uint8_t*>(&motionSettings),sizeof(motionSettings)-sizeof(motionSettings.checksum));
  if(motionSettings.checksum==motionSavedChecksum)return true;
  File f=LittleFS.open("/motion.tmp","w");
  if(!f)return false;
  size_t written=f.write(reinterpret_cast<const uint8_t*>(&motionSettings),sizeof(motionSettings));
  f.flush();f.close();
  if(written!=sizeof(motionSettings)||!LittleFS.rename("/motion.tmp","/motion.cfg"))return false;
  motionSavedChecksum=motionSettings.checksum;
  return true;
}
void loadMotionSettings() {
  resetMotionSettings();
  File f=LittleFS.open("/motion.cfg","r");
  if(!f)return;
  MotionSettings loaded;
  bool ok=f.size()==sizeof(loaded)&&f.read(reinterpret_cast<uint8_t*>(&loaded),sizeof(loaded))==sizeof(loaded);
  f.close();
  if(ok&&validMotionSettings(loaded)){motionSettings=loaded;motionSavedChecksum=loaded.checksum;}
}
void readMotionRequest(uint8_t i) {
  if(server.hasArg("directMotion")){int mode=server.arg("directMotion").toInt();motionSettings.mode[i]=(mode>=0&&mode<=10)||isLibraryId(mode)?mode:0;}
  if(server.hasArg("motionCycle"))motionSettings.cycleMs[i]=constrain(server.arg("motionCycle").toInt(),1000,12000);
}

void loadConfig() {
  EEPROM.begin(EEPROM_SIZE);

  uint32_t magic = 0;
  EEPROM.get(0, magic);

  if (magic == CONFIG_MAGIC) {
    EEPROM.get(0, config);
  }
  else if (magic == LEGACY_CONFIG_MAGIC_V25) {
    ConfigV25 oldConfig;
    EEPROM.get(0, oldConfig);

    setDefaults();

    strlcpy(config.apSSID, oldConfig.apSSID, sizeof(config.apSSID));
    strlcpy(config.apPassword, oldConfig.apPassword, sizeof(config.apPassword));
    strlcpy(config.deviceName, oldConfig.deviceName, sizeof(config.deviceName));
    config.startupAnimation = oldConfig.startupAnimation;

    config.externalWiFiEnabled = oldConfig.externalWiFiEnabled;
    config.knownWiFiCount = min(oldConfig.knownWiFiCount, MAX_KNOWN_WIFI);

    for (uint8_t i = 0; i < MAX_KNOWN_WIFI; i++) {
      config.knownWiFi[i] = oldConfig.knownWiFi[i];
    }

    for (uint8_t i = 0; i < MACRO_COUNT; i++) {
      copyV25MacroToV26(oldConfig.macro[i], config.macro[i]);
    }

    config.magic = CONFIG_MAGIC;
    saveConfig();

    Serial.println(F("[CONFIG] Migration V2.5 -> V2.6 effectuee"));
  }
  else if (magic == LEGACY_CONFIG_MAGIC_V19) {
    ConfigV19 oldConfig;
    EEPROM.get(0, oldConfig);

    setDefaults();

    strlcpy(config.apSSID, oldConfig.apSSID, sizeof(config.apSSID));
    strlcpy(config.apPassword, oldConfig.apPassword, sizeof(config.apPassword));
    strlcpy(config.deviceName, oldConfig.deviceName, sizeof(config.deviceName));
    config.startupAnimation = oldConfig.startupAnimation;

    config.externalWiFiEnabled = oldConfig.externalWiFiEnabled;
    config.knownWiFiCount = min(oldConfig.knownWiFiCount, MAX_KNOWN_WIFI);

    for (uint8_t i = 0; i < MAX_KNOWN_WIFI; i++) {
      config.knownWiFi[i] = oldConfig.knownWiFi[i];
    }

    for (uint8_t i = 0; i < MACRO_COUNT; i++) {
      copyLegacyMacroToV2(oldConfig.macro[i], config.macro[i]);
    }

    config.magic = CONFIG_MAGIC;
    saveConfig();

    Serial.println(F("[CONFIG] Migration V1.9 -> V2.0 effectuee"));
  }
  else if (magic == LEGACY_CONFIG_MAGIC_V18 ||
           magic == LEGACY_CONFIG_MAGIC_V14 ||
           magic == LEGACY_CONFIG_MAGIC_V12) {

    ConfigSingleWiFi oldConfig;
    EEPROM.get(0, oldConfig);

    setDefaults();

    strlcpy(config.apSSID, oldConfig.apSSID, sizeof(config.apSSID));
    strlcpy(config.apPassword, oldConfig.apPassword, sizeof(config.apPassword));
    strlcpy(config.deviceName, oldConfig.deviceName, sizeof(config.deviceName));
    config.startupAnimation = oldConfig.startupAnimation;

    config.externalWiFiEnabled = oldConfig.externalWiFiEnabled;

    for (uint8_t i = 0; i < MACRO_COUNT; i++) {
      copyLegacyMacroToV2(oldConfig.macro[i], config.macro[i]);
    }

    if (strlen(oldConfig.externalSSID) > 0) {
      rememberWiFi(
        String(oldConfig.externalSSID),
        String(oldConfig.externalPassword)
      );
    }

    config.magic = CONFIG_MAGIC;
    saveConfig();

    Serial.println(F("[CONFIG] Migration ancienne version -> V2.0 effectuee"));
  }
  else if (magic == LEGACY_CONFIG_MAGIC_V11) {
    ConfigV11 oldConfig;
    EEPROM.get(0, oldConfig);

    setDefaults();

    strlcpy(config.apSSID, oldConfig.apSSID, sizeof(config.apSSID));
    strlcpy(config.apPassword, oldConfig.apPassword, sizeof(config.apPassword));
    strlcpy(config.deviceName, oldConfig.deviceName, sizeof(config.deviceName));
    config.startupAnimation = oldConfig.startupAnimation;

    for (uint8_t i = 0; i < MACRO_COUNT; i++) {
      copyLegacyMacroToV2(oldConfig.macro[i], config.macro[i]);
    }

    config.magic = CONFIG_MAGIC;
    saveConfig();

    Serial.println(F("[CONFIG] Migration V1.1 -> V2.0 effectuee"));
  }
  else {
    setDefaults();
    saveConfig();
  }

  config.apSSID[sizeof(config.apSSID)-1] = '\0';
  config.apPassword[sizeof(config.apPassword)-1] = '\0';
  config.deviceName[sizeof(config.deviceName)-1] = '\0';

  config.knownWiFiCount = min(config.knownWiFiCount, MAX_KNOWN_WIFI);

  for (uint8_t i = 0; i < MAX_KNOWN_WIFI; i++) {
    config.knownWiFi[i].ssid[sizeof(config.knownWiFi[i].ssid)-1] = '\0';
    config.knownWiFi[i].password[sizeof(config.knownWiFi[i].password)-1] = '\0';
  }

  for (uint8_t i = 0; i < MACRO_COUNT; i++) {
    config.macro[i].name[sizeof(config.macro[i].name)-1] = '\0';
    config.macro[i].logoPath[sizeof(config.macro[i].logoPath)-1] = '\0';

    config.macro[i].intensity = constrain(config.macro[i].intensity, 0, 100);
    config.macro[i].idleIntensity = constrain(config.macro[i].idleIntensity, 0, 100);
    if(config.macro[i].alertAnimation>ALERT_CUSTOM&&!isLibraryId(config.macro[i].alertAnimation))config.macro[i].alertAnimation=ALERT_CLASSIC;
    config.macro[i].alertDuration = constrain(config.macro[i].alertDuration, 1, 60);
    config.macro[i].blinkMs = constrain(config.macro[i].blinkMs, 100, 2000);
    config.macro[i].alertEndOn = true;
  }
}

uint8_t scaleByPercent(uint8_t value, uint8_t percent) {
  return (uint8_t)(((uint16_t)value * constrain((int)percent, 0, 100)) / 100U);
}

// Sortie 0..100% pour les 36 LED du logo Damien.
// Montage utilisateur USB-C / VV : 1,02 A mesure sur le ruban blanc 100%,
// stable selon essai utilisateur ; courant admissible VV non documente.
// Toute sortie LED passe par pixelColorLevel(), y compris les alertes
// et les effets spatiaux (qui peuvent ignorer le curseur de macro).
const uint8_t LED_GLOBAL_MAX_PERCENT = 100;

uint32_t pixelColorLevel(uint8_t r, uint8_t g, uint8_t b, uint8_t intensity) {
  const uint8_t cappedIntensity =
    min((uint8_t)constrain((int)intensity, 0, 100), LED_GLOBAL_MAX_PERCENT);

  return pixels.Color(
    scaleByPercent(r, cappedIntensity),
    scaleByPercent(g, cappedIntensity),
    scaleByPercent(b, cappedIntensity)
  );
}

void setPixelLevel(uint16_t index,
                   uint8_t r,
                   uint8_t g,
                   uint8_t b,
                   uint8_t intensity) {
  if (index >= LED_COUNT) return;
  pixels.setPixelColor(index, pixelColorLevel(r,g,b,intensity));
}

void setRGBLevel(uint8_t r, uint8_t g, uint8_t b, uint8_t intensity) {
  currentLedR = r;
  currentLedG = g;
  currentLedB = b;
  currentLedIntensity = constrain((int)intensity, 0, 100);

  uint32_t color = pixelColorLevel(r,g,b,currentLedIntensity);

  for (uint16_t i = 0; i < LED_COUNT; i++) {
    pixels.setPixelColor(i, color);
  }

  pixels.show();
}

void ledsOff() {
  currentLedR = 0;
  currentLedG = 0;
  currentLedB = 0;
  currentLedIntensity = 0;

  pixels.clear();
  pixels.show();
}

void updateLedStatusReference(uint8_t r,
                              uint8_t g,
                              uint8_t b,
                              uint8_t intensity) {
  currentLedR = r;
  currentLedG = g;
  currentLedB = b;
  currentLedIntensity = constrain((int)intensity, 0, 100);
}

void renderLogoChase(uint8_t r,
                     uint8_t g,
                     uint8_t b,
                     uint8_t intensity,
                     unsigned long elapsed,
                     unsigned long cycleMs) {
  cycleMs = max(300UL, cycleMs);

  // Une tete lumineuse et une queue de 6 LED font le tour du logo.
  uint16_t head =
    (uint16_t)(((elapsed % cycleMs) * LED_COUNT) / cycleMs);

  pixels.clear();

  const uint8_t tailLength = 6;

  for (uint8_t tail = 0; tail < tailLength; tail++) {
    uint16_t index =
      (head + LED_COUNT - tail) % LED_COUNT;

    uint8_t tailIntensity =
      (uint8_t)(((uint16_t)intensity * (tailLength - tail)) / tailLength);

    setPixelLevel(index, r, g, b, tailIntensity);
  }

  pixels.show();
  updateLedStatusReference(r,g,b,intensity);
}

void renderLogoDraw(uint8_t r,
                    uint8_t g,
                    uint8_t b,
                    uint8_t intensity,
                    unsigned long elapsed,
                    unsigned long cycleMs) {
  uint8_t frame[36][3];
  renderContourFrame(r,g,b,intensity,elapsed,max(700UL,cycleMs),frame);
  showMotionFrame(frame);updateLedStatusReference(r,g,b,intensity);
}


// BEGIN PORTABLE MOTION ENGINE
// Face vue de face : 0 bas droit -> 11 bas gauche -> 16 haut gauche
// -> 30 haut droit -> 35 bas droit. Positions normalisees, pas de mm supposes.
static const uint16_t MOTION_LED_COUNT = 36;
static const uint32_t BOOT_CINEMA_MS = 4500;

float logoX(uint16_t i) {
  if (i < 12) return (11.0f-i)/11.0f;
  if (i < 17) return 0.0f;
  if (i < 31) return (i-17)/13.0f;
  return 1.0f;
}
float logoY(uint16_t i) {
  if (i < 12) return 1.0f;
  if (i < 17) return (17.0f-i)/6.0f;
  if (i < 31) return 0.0f;
  return (i-30)/6.0f;
}
float motionClamp(float x) { return x < 0 ? 0 : x > 1 ? 1 : x; }
float motionSmooth(float x) { x=motionClamp(x); return x*x*(3-2*x); }
void motionRGB(uint8_t out[3], uint8_t r, uint8_t g, uint8_t b, float level) {
  level=motionClamp(level);
  out[0]=(uint8_t)(r*level+0.0001f);out[1]=(uint8_t)(g*level+0.0001f);out[2]=(uint8_t)(b*level+0.0001f);
}
void motionRainbow(float hue, uint8_t out[3], float level) {
  hue=hue-floorf(hue);float h=hue*6;int sector=(int)h;float f=h-sector;
  float r=0,g=0,b=0;
  switch(sector){
    case 0:r=1;g=f;break;case 1:r=1-f;g=1;break;
    case 2:g=1;b=f;break;case 3:g=1-f;b=1;break;
    case 4:r=f;b=1;break;default:r=1;b=1-f;break;
  }
  motionRGB(out,(uint8_t)(255*r),(uint8_t)(255*g),(uint8_t)(255*b),level);
}
// Modes : fixe, respiration, balayage G>D, D>G, comete, aller-retour,
// arc-en-ciel horizontal, ouverture depuis le centre.
void renderMotionFrame(uint8_t mode, uint8_t r, uint8_t g, uint8_t b,
                       uint8_t intensity, uint32_t elapsed, uint32_t cycle,
                       uint8_t frame[][3], bool isolateSurfaces=false) {
  if(cycle<500)cycle=500;
  float p=(elapsed%cycle)/(float)cycle;
  float peak=(intensity>100?100:intensity)/100.0f;
  for(uint16_t i=0;i<MOTION_LED_COUNT;i++){
    float x=logoX(i),level=1;
    if(mode==1)level=.15f+.85f*(.5f-.5f*cosf(p*6.28318530718f));
    else if(mode==2||mode==3||mode==5){
      float pos=(mode==5||isolateSurfaces)?(.5f-.5f*cosf(p*6.28318530718f)):p;
      if(mode==3)pos=1-pos;
      float d=fabsf(x-pos);
      level=.08f+.92f*motionSmooth(1-d/.30f);
    }else if(mode==8||mode==9){
      float pos=.5f-.5f*cosf(p*6.28318530718f);if(mode==9)pos=1-pos;
      level=.08f+.92f*motionSmooth(1-fabsf(logoY(i)-pos)/.30f);
    }else if(mode==4){
      float d=fmodf(p*36-i+36,36);level=d<7?1-d/7:.04f;
    }else if(mode==7){
      float distance=fabsf(x-.5f)*2;
      level=.08f+.92f*motionSmooth((p*1.4f-distance)/.28f);
    }
    bool side=(i>=12&&i<17)||i>=31;
    if((isolateSurfaces&&(mode==2||mode==3||mode==5||mode==7)&&side)||((mode==8||mode==9)&&!side))level=0;
    if(mode==6)motionRainbow(x*.8f-p,frame[i],peak);
    else motionRGB(frame[i],r,g,b,level*peak);
  }
}
// Retour false apres la derniere image. Aucun delay, acces reseau ou flash.
bool renderBootFrame(uint32_t elapsed,uint8_t frame[][3]) {
  for(uint16_t i=0;i<MOTION_LED_COUNT;i++)motionRGB(frame[i],0,0,0,0);
  if(elapsed>=BOOT_CINEMA_MS)return false;
  for(uint16_t i=0;i<MOTION_LED_COUNT;i++){
    float x=logoX(i);
    if(elapsed<1700){
      float pos=-.45f+1.9f*elapsed/1700.0f;
      float level=motionSmooth(1-fabsf(x-pos)/.55f)*.7f;
      motionRainbow(x*.85f-elapsed/2500.0f,frame[i],level);
    }else if(elapsed<1760)motionRGB(frame[i],255,255,255,.7f);
    else if(elapsed<1840){}
    else if(elapsed<2740)motionRGB(frame[i],255,255,255,.65f*motionSmooth((elapsed-1840)/900.0f));
    else if(elapsed<3650){
      float distance=fabsf(x-.5f)*2;
      float wave=motionSmooth(((elapsed-2740)/910.0f*1.35f-distance)/.3f);
      motionRGB(frame[i],255,(uint8_t)(255*(1-wave)),(uint8_t)(255*(1-wave)),.65f);
    }else if(elapsed<4100)motionRGB(frame[i],255,0,0,.65f);
    else motionRGB(frame[i],255,0,0,.65f*(1-motionSmooth((elapsed-4100)/400.0f)));
  }
  return true;
}
bool isLibraryId(int id){return id>=32&&id<48;}
void renderContourFrame(uint8_t r,uint8_t g,uint8_t b,uint8_t intensity,uint32_t elapsed,uint32_t cycle,uint8_t frame[][3]){
  float phase=(elapsed%cycle)*72.0f/cycle;
  for(uint8_t i=0;i<36;i++){
    float level=phase<36?motionClamp(phase-i):1-motionClamp(phase-36-i);
    motionRGB(frame[i],r,g,b,level*(intensity>100?100:intensity)/100.0f);
  }
}
uint16_t cueField(const uint8_t* c){return c[2]|((uint16_t)c[3]<<8);}
uint32_t cueDuration(const uint8_t* c){uint16_t f=cueField(c);return (c[0]|((uint16_t)c[1]<<8))+((f&0x8000)?0:f);}
uint32_t cueFrameInterval(const uint8_t* data){
  for(uint8_t n=0;n<data[5];n++){uint16_t f=cueField(data+8+n*112);if((f&0x8000)&&(f&0x3fff)<66)return 10;}
  return 33;
}
void renderCuePixels(const uint8_t* c,uint32_t t,uint8_t frame[][3]){
  uint16_t f=cueField(c);const uint8_t* rgb=c+4;
  if(!(f&0x8000)){memcpy(frame,rgb,108);return;}
  memset(frame,0,108);uint16_t speed=f&0x3fff;if(speed<20)speed=20;
  if(f&0x4000){
    if((t/speed)%2==0)for(uint8_t led=0;led<36;led++)if(rgb[3+led/8]&(1<<(led%8)))memcpy(frame[led],rgb,3);
  }else{
    int start=rgb[0],end=rgb[1],distance=start>end?start-end:end-start;
    int led=start+(start>end?-1:1)*((t/speed)%(distance+1));
    if(led>=0&&led<36)memcpy(frame[led],rgb+2,3);
  }
}
void renderCueFrame(const uint8_t* data,uint8_t intensity,uint32_t elapsed,uint8_t frame[][3]){
  uint32_t total=0;for(uint8_t n=0;n<data[5];n++)total+=cueDuration(data+8+n*112);
  if(!total){memset(frame,0,108);return;}uint32_t t=elapsed%total;
  float peak=(intensity>100?100:intensity)/100.0f*(data[4]==2?data[6]/100.0f:1.0f);
  for(uint8_t n=0;n<data[5];n++){
    const uint8_t* c=data+8+n*112;uint32_t duration=cueDuration(c);
    if(t>=duration){t-=duration;continue;}
    uint16_t fade=cueField(c);renderCuePixels(c,t,frame);
    if(!(fade&0x8000)&&fade){
      const uint8_t* previous=data+8+(n?n-1:data[5]-1)*112;uint8_t before[36][3];
      renderCuePixels(previous,cueDuration(previous)-1,before);float mix=motionClamp(t/(float)fade);
      for(uint8_t led=0;led<36;led++)for(uint8_t k=0;k<3;k++){
        uint8_t a=(!n&&elapsed<total)?0:before[led][k];frame[led][k]=(uint8_t)(a+(frame[led][k]-a)*mix);
      }
    }
    for(uint8_t led=0;led<36;led++)for(uint8_t k=0;k<3;k++)frame[led][k]=(uint8_t)(frame[led][k]*peak);
    return;
  }
}
// END PORTABLE MOTION ENGINE

void showMotionFrame(const uint8_t frame[][3]) {
  for(uint16_t i=0;i<LED_COUNT;i++)setPixelLevel(i,frame[i][0],frame[i][1],frame[i][2],100);
  pixels.show();
}
void renderSpatialMotion(uint8_t mode,uint8_t r,uint8_t g,uint8_t b,uint8_t intensity,unsigned long elapsed,unsigned long cycle,bool isolateSurfaces=false) {
  uint8_t frame[MOTION_LED_COUNT][3];
  renderMotionFrame(mode,r,g,b,intensity,elapsed,cycle,frame,isolateSurfaces);
  showMotionFrame(frame);updateLedStatusReference(r,g,b,intensity);
}

void cancelStartupIndicator() {
  startupSequenceComplete=true;startupIndicatorState=STARTUP_IND_OFF;startupTestActive=false;
}
// Les evenements reseau ne coupent jamais la cinematrique. L'etat reel est
// consulte apres celle-ci, meme si le Wi-Fi a deja reussi entre-temps.
void setStartupIndicatorState(StartupIndicatorState state) {
  if(state==STARTUP_IND_ERROR)startupAPFailed=true;
}
void enterStartupState(StartupIndicatorState state) {
  startupIndicatorState=state;startupStateStartedAt=millis();
}
void updateStartupIndicatorNetworkState() {
  if(startupSequenceComplete)return;
  if(alertRunning||settingsPreviewActive||activeMacro>=0||outputEnabled)cancelStartupIndicator();
}
void finishStartupSequence() {
  int restore=startupTestActive?startupRestoreMacro:-1;
  cancelStartupIndicator();ledsOff();
  if(restore>=0&&restore<MACRO_COUNT)applyMacroIdle(restore);
}
void updateStartupIndicator() {
  if(startupSequenceComplete||(!config.startupAnimation&&!startupTestActive))return;
  unsigned long now=millis();
  if(now-startupIndicatorLastToggle<25UL)return;
  startupIndicatorLastToggle=now;
  unsigned long elapsed=now-startupStateStartedAt;
  uint8_t frame[MOTION_LED_COUNT][3];
  switch(startupIndicatorState){
    case STARTUP_IND_INTRO:
      if(renderBootFrame(elapsed,frame)){showMotionFrame(frame);return;}
      enterStartupState(STARTUP_IND_AP);return;
    case STARTUP_IND_AP:
      renderSpatialMotion(4,40,130,255,30,elapsed,1000);
      if(elapsed>=900){
        startupAPFailed=WiFi.softAPIP()!=AP_IP;
        if(startupAPFailed)enterStartupState(STARTUP_IND_ERROR);
        else if(config.externalWiFiEnabled&&config.knownWiFiCount>0)enterStartupState(STARTUP_IND_WIFI);
        else enterStartupState(STARTUP_IND_FALLBACK);
      }return;
    case STARTUP_IND_WIFI:
    case STARTUP_IND_MDNS:
      if(WiFi.status()==WL_CONNECTED){enterStartupState(STARTUP_IND_READY);return;}
      if(now-startupSessionStartedAt>=15000UL){enterStartupState(STARTUP_IND_ERROR);return;}
      renderSpatialMotion(5,255,125,15,28,elapsed,1800);return;
    case STARTUP_IND_READY:
      if(elapsed>=1050){finishStartupSequence();return;}
      if((elapsed/175)%2==0)setRGBLevel(40,255,100,35);else ledsOff();return;
    case STARTUP_IND_ERROR:
      if(elapsed>=1500){
        if(startupAPFailed)finishStartupSequence();else enterStartupState(STARTUP_IND_FALLBACK);
        return;
      }
      if(elapsed%500<150)setRGBLevel(255,startupAPFailed?0:115,0,35);else ledsOff();return;
    case STARTUP_IND_FALLBACK:
      if(elapsed>=1600){finishStartupSequence();return;}
      renderSpatialMotion(1,45,125,255,28,elapsed,800);return;
    default:finishStartupSequence();return;
  }
}

// Custom timeline: 12 cues, each hold/fade + 36 RGB pixels; one cache in RAM.
static uint8_t customData[1356];
static int customOwner=-1;
static bool customValid=false;
static bool customPreview=false;
static bool customPreviewAlert=false;
static bool libraryPreviewActive=false,libraryPreviewPlaying=false;
static uint8_t libraryPreviewCue=0;
static unsigned long libraryPreviewStarted=0,libraryPreviewLastFrame=0;
const unsigned long LIBRARY_PREVIEW_LEASE_MS=15000UL;
static char libraryPreviewToken[41]={},libraryPreviewRevokedToken[41]={};

uint16_t customWord(const uint8_t* p){return p[0]|((uint16_t)p[1]<<8);}
bool validCustom(const uint8_t* p){
  if(memcmp(p,"CUE1",4)||(p[4]!=1&&p[4]!=2)||p[5]<1||p[5]>12)return false;
  if(p[4]==1?(p[6]||p[7]):(p[6]>100||p[7]!=0xA5))return false;
  uint32_t stored=0;memcpy(&stored,p+1352,4);
  if(configChecksum(p,1352)!=stored)return false;
  for(uint8_t n=0;n<p[5];n++){
    const uint8_t* c=p+8+n*112;
    uint16_t effect=customWord(c+2);
    if(customWord(c)<100||customWord(c)>60000)return false;
    if(effect&0x8000){
      if(p[4]!=2||(effect&0x3fff)<20||(effect&0x3fff)>10000)return false;
      if(!(effect&0x4000)&&(c[4]>35||c[5]>35))return false;
    }else if(effect>20000)return false;
  }
  return true;
}
bool loadCustom(uint8_t i){
  if(customOwner==i)return customValid;
  customOwner=i;customValid=false;
  char path[24];snprintf(path,sizeof(path),isLibraryId(i)?"/anim%u.bin":"/custom%u.bin",i);
  File f=LittleFS.open(path,"r");
  if(!f)return false;
  bool ok=f.size()==sizeof(customData)+(isLibraryId(i)?64:0);
  if(isLibraryId(i)){uint8_t name[64];ok=ok&&f.read(name,64)==64;}
  ok=ok&&f.read(customData,sizeof(customData))==sizeof(customData);
  f.close();customValid=ok&&validCustom(customData);return customValid;
}
void renderCustomOutput(uint8_t i,unsigned long elapsed,bool alert=false){
  MacroConfig& m=config.macro[i];
  if(!loadCustom(i+(alert?MACRO_COUNT:0))){setRGBLevel(m.r,m.g,m.b,m.intensity);return;}
  uint8_t frame[36][3];renderCueFrame(customData,m.intensity,elapsed,frame);
  showMotionFrame(frame);updateLedStatusReference(m.r,m.g,m.b,m.intensity);
}
void renderLibraryOutput(uint8_t i,uint8_t id,unsigned long elapsed){
  MacroConfig& m=config.macro[i];
  if(!loadCustom(id)){setRGBLevel(m.r,m.g,m.b,m.intensity);return;}
  uint8_t frame[36][3];renderCueFrame(customData,m.intensity,elapsed,frame);
  showMotionFrame(frame);updateLedStatusReference(m.r,m.g,m.b,m.intensity);
}

void renderMacroDirect(uint8_t i) {
  if (i >= MACRO_COUNT) return;

  MacroConfig& m = config.macro[i];
  if(!alertRunning&&isLibraryId(motionSettings.mode[i])){renderLibraryOutput(i,motionSettings.mode[i],millis()-directMotionStartedAt);return;}
  if(!alertRunning&&(motionSettings.mode[i]==10||(settingsPreviewActive&&customPreview))){renderCustomOutput(i,millis()-directMotionStartedAt,settingsPreviewActive&&customPreview&&customPreviewAlert);return;}
  if(!alertRunning&&motionSettings.mode[i])renderSpatialMotion(motionSettings.mode[i],m.r,m.g,m.b,m.intensity,millis()-directMotionStartedAt,motionSettings.cycleMs[i],true);
  else setRGBLevel(m.r, m.g, m.b, m.intensity);
}

void renderMacroIdle(uint8_t i) {
  if (i >= MACRO_COUNT) {
    ledsOff();
    return;
  }

  MacroConfig& m = config.macro[i];

  if (m.idleOff || m.idleIntensity == 0) {
    ledsOff();
  } else {
    setRGBLevel(m.idleR, m.idleG, m.idleB, m.idleIntensity);
  }
}

void renderCurrentOutput() {
  if (alertRunning) return;

  if (activeMacro < 0 || activeMacro >= MACRO_COUNT) {
    ledsOff();
    return;
  }

  if (outputEnabled) {
    renderMacroDirect(activeMacro);
  } else {
    renderMacroIdle(activeMacro);
  }
}

void applyMacro(uint8_t i) {
  if (i >= MACRO_COUNT) return;

  cancelStartupIndicator();
  settingsPreviewActive = false;
  alertRunning = false;
  alertMacro = -1;

  activeMacro = i;
  outputEnabled = true;
  directMotionStartedAt=millis();

  renderMacroDirect(i);

  Serial.println("[MACRO] DIRECT " + String(i+1) + " - " + String(config.macro[i].name));
}

void applyMacroIdle(uint8_t i) {
  if (i >= MACRO_COUNT) return;

  cancelStartupIndicator();
  settingsPreviewActive = false;
  alertRunning = false;
  alertMacro = -1;

  activeMacro = i;
  outputEnabled = false;

  renderMacroIdle(i);

  Serial.println("[MACRO] HORS DIRECT " + String(i+1) + " - " + String(config.macro[i].name));
}

void blackout() {
  cancelStartupIndicator();
  settingsPreviewActive = false;
  alertRunning = false;
  alertTestMode = false;
  alertMacro = -1;
  activeMacro = -1;
  outputEnabled = false;
  ledsOff();

  Serial.println(F("[ON AIR] ETEINT / AUCUNE MACRO SELECTIONNEE"));
}

void startAlert(uint8_t i, bool testMode = false) {
  if (i >= MACRO_COUNT) return;

  cancelStartupIndicator();
  settingsPreviewActive = false;

  alertRunning = true;
  alertTestMode = testMode;
  alertMacro = i;
  activeMacro = i;

  // Pendant la cinematrique on n'est pas encore en DIRECT.
  outputEnabled = false;

  alertStartedAt = millis();
  alertLastToggleAt = millis();
  alertAnimLastFrameAt = 0;
  alertVisible = true;

  renderMacroDirect(i);

  if (alertTestMode) {
    Serial.println("[MACRO] TEST ALERTE " + String(i+1) + " - " + String(config.macro[i].name));
  } else {
    Serial.println("[MACRO] ALERTE " + String(i+1) + " - " + String(config.macro[i].name));
  }
}

uint8_t lerp8(uint8_t a, uint8_t b, float t) {
  if (t < 0.0f) t = 0.0f;
  if (t > 1.0f) t = 1.0f;
  return (uint8_t)(a + (b - a) * t);
}

void renderTrafficGradient(float progress, uint8_t intensity) {
  // Un seul passage sur toute la duree :
  // 0% = vert, 50% = jaune, 100% = rouge.
  if (progress < 0.0f) progress = 0.0f;
  if (progress > 1.0f) progress = 1.0f;

  uint8_t r;
  uint8_t g;

  if (progress <= 0.5f) {
    float t = progress / 0.5f;
    r = lerp8(0, 255, t);
    g = 255;
  } else {
    float t = (progress - 0.5f) / 0.5f;
    r = 255;
    g = lerp8(255, 0, t);
  }

  setRGBLevel(r, g, 0, intensity);
  alertVisible = true;
}

void finishAlert() {
  bool wasTest = alertTestMode;
  int finishedMacro = alertMacro;

  alertRunning = false;
  alertTestMode = false;

  if (wasTest) {
    blackout();
    Serial.println(F("[ALERTE TEST] Fin -> TOUT ETEINT"));
    return;
  }

  // Sortie propre de l'etat ALERTE puis passage DIRECT.
  // Important pour l'interface : le bouton DIRECT devient actif,
  // le bouton ALERTE revient immediatement a son etat normal.
  alertMacro = -1;
  alertVisible = false;

  activeMacro = finishedMacro;
  outputEnabled = true;
  directMotionStartedAt=millis();

  renderMacroDirect(activeMacro);

  Serial.println("[ALERTE] Fin propre -> DIRECT " + String(activeMacro + 1));
}

void updateAlert() {
  if (!alertRunning || alertMacro < 0 || alertMacro >= MACRO_COUNT) return;

  MacroConfig& m = config.macro[alertMacro];

  unsigned long now = millis();
  unsigned long elapsed = now - alertStartedAt;
  unsigned long totalMs = max(1UL, (unsigned long)m.alertDuration * 1000UL);

  if (elapsed >= totalMs) {
    finishAlert();
    return;
  }

  if(isLibraryId(m.alertAnimation)){
    if(now-alertAnimLastFrameAt<cueFrameInterval(customData))return;alertAnimLastFrameAt=now;
    renderLibraryOutput(alertMacro,m.alertAnimation,elapsed);alertVisible=true;return;
  }

  // Progression globale 0.0 -> 1.0 sur EXACTEMENT la duree demandee.
  float progress = (float)elapsed / (float)totalMs;

  switch (m.alertAnimation) {

    case ALERT_FADE_TO_BLACK: {
      // Boucle "flash + fade" :
      // 100 % instantane -> fade progressif jusqu'a 0 % -> retour instantane a 100 %.
      // blinkMs regle la duree d'un cycle complet.
      if (now - alertAnimLastFrameAt < 20UL) return;
      alertAnimLastFrameAt = now;

      unsigned long cycle =
        max(300UL, (unsigned long)m.blinkMs);

      unsigned long pos = elapsed % cycle;
      float cycleProgress = (float)pos / (float)cycle;

      uint8_t level =
        (uint8_t)(100.0f * (1.0f - cycleProgress));

      setRGBLevel(m.r, m.g, m.b, level);
      alertVisible = level > 4;
      break;
    }

    case ALERT_TRAFFIC_GRADIENT: {
      // UN SEUL passage sur toute la duree :
      // vert -> jaune -> rouge.
      if (now - alertAnimLastFrameAt < 20UL) return;
      alertAnimLastFrameAt = now;

      renderTrafficGradient(progress, m.intensity);
      break;
    }

    case ALERT_ACCELERATING: {
      // Toute l'acceleration est calculee sur la duree totale.
      float remain = 1.0f - progress;

      unsigned long startInterval =
        max(300UL, (unsigned long)m.blinkMs * 2UL);

      unsigned long interval =
        60UL +
        (unsigned long)((startInterval - 60UL) * remain * remain);

      if (now - alertLastToggleAt >= interval) {
        alertLastToggleAt = now;
        alertVisible = !alertVisible;

        if (alertVisible) renderMacroDirect(alertMacro);
        else renderMacroIdle(alertMacro);
      }
      break;
    }

    case ALERT_DOUBLE_FLASH: {
      // Heartbeat repete pendant la duree demandee.
      // blinkMs regle ici le rythme du heartbeat.
      if (now - alertAnimLastFrameAt < 20UL) return;
      alertAnimLastFrameAt = now;

      unsigned long pulse =
        constrain((unsigned long)m.blinkMs / 4UL, 55UL, 130UL);

      unsigned long cycle =
        max(500UL, (unsigned long)m.blinkMs * 2UL);

      unsigned long pos = elapsed % cycle;

      bool on =
        (pos < pulse) ||
        (pos >= pulse * 2UL && pos < pulse * 3UL);

      if (on) {
        renderMacroDirect(alertMacro);
        alertVisible = true;
      } else {
        renderMacroIdle(alertMacro);
        alertVisible = false;
      }
      break;
    }

    case ALERT_LOGO_CHASE: {
      if (now - alertAnimLastFrameAt < 25UL) return;
      alertAnimLastFrameAt = now;

      unsigned long cycle =
        max(500UL, (unsigned long)m.blinkMs * 2UL);

      renderLogoChase(
        m.r, m.g, m.b, m.intensity,
        elapsed, cycle
      );

      alertVisible = true;
      break;
    }

    case ALERT_LOGO_DRAW: {
      if (now - alertAnimLastFrameAt < 25UL) return;
      alertAnimLastFrameAt = now;

      unsigned long cycle =
        max(700UL, (unsigned long)m.blinkMs * 3UL);

      renderLogoDraw(
        m.r, m.g, m.b, m.intensity,
        elapsed, cycle
      );

      alertVisible = true;
      break;
    }

    case ALERT_CUSTOM: {
      if(now-alertAnimLastFrameAt<cueFrameInterval(customData))return;
      alertAnimLastFrameAt=now;renderCustomOutput(alertMacro,elapsed,true);
      alertVisible=true;break;
    }
    case ALERT_SWEEP_LR:
    case ALERT_SWEEP_RL:
    case ALERT_BREATHE:
    case ALERT_IRIS:
    case ALERT_SWEEP_TB:
    case ALERT_SWEEP_BT:
    case ALERT_RAINBOW: {
      if(now-alertAnimLastFrameAt<cueFrameInterval(customData))return;
      alertAnimLastFrameAt=now;
      uint8_t mode=m.alertAnimation==ALERT_SWEEP_TB?8:m.alertAnimation==ALERT_SWEEP_BT?9:m.alertAnimation==ALERT_SWEEP_LR?2:m.alertAnimation==ALERT_SWEEP_RL?3:m.alertAnimation==ALERT_BREATHE?1:m.alertAnimation==ALERT_IRIS?7:6;

void copyLegacyMacroToV2(const MacroConfigV19& oldM, MacroConfig& newM) {
  memset(&newM, 0, sizeof(newM));

  strlcpy(newM.name, oldM.name, sizeof(newM.name));

  newM.r = oldM.r;
  newM.g = oldM.g;
  newM.b = oldM.b;
  newM.intensity = constrain(oldM.intensity, 0, 100);

  // Migration : le comportement precedent etait eteint hors direct.
  newM.idleOff = true;
  newM.idleR = oldM.r;
  newM.idleG = oldM.g;
  newM.idleB = oldM.b;
  newM.idleIntensity = 20;

  newM.alertAnimation = ALERT_CLASSIC;
  newM.alertDuration = constrain(oldM.alertDuration, 1, 60);
  newM.blinkMs = constrain(oldM.blinkMs, 100, 2000);
  newM.alertEndOn = true;

  strlcpy(newM.logoPath, oldM.logoPath, sizeof(newM.logoPath));
}

